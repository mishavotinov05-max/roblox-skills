}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002259"><Properties>
<string name="Name">PitConfig</string>
<ProtectedString name="Source"><![CDATA[--[[
	PitConfig — ямы прокачки силы в лобби (как на картинке-референсе).

	Порядок в списке = номер ямы на карте: 1-я строка — Pit_01, 2-я — Pit_02 …
	(Workspace › Map › Hub › Pits).

	RequiredRebirths — сколько перерождений нужно, чтобы яма открылась.
	Power            — сколько силы даёт один удар в этой яме (до множителей).
	                   Удар по воздуху даёт GameSettings.AirSwingPower (1), в ямах — больше.
	В открытой яме кирка бьёт сама (GameSettings.PitAutoInterval), клики добавляют удары.
	Опыт (уровень) тоже качается только в ямах.

	Чтобы добавить яму: допишите строку и скопируйте модель Pit_07 → Pit_08.
]]

return {
	Pits = {
		{ Name = "Обычная яма", RequiredRebirths = 0, Power = 2 },
		{ Name = "Угольная яма", RequiredRebirths = 3, Power = 6 },
		{ Name = "Каменная яма", RequiredRebirths = 9, Power = 16 },
		{ Name = "Железная яма", RequiredRebirths = 18, Power = 40 },
		{ Name = "Золотая яма", RequiredRebirths = 36, Power = 100 },
		{ Name = "Алмазная яма", RequiredRebirths = 50, Power = 240 },
		{ Name = "Мифическая яма", RequiredRebirths = 65, Power = 600 },
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002260"><Properties>
<string name="Name">RebirthConfig</string>
<ProtectedString name="Source"><![CDATA[--[[
	RebirthConfig — перерождения.

	Перерождение зависит от УРОВНЯ игрока (уровень качается в ямах):
	  нужный уровень для перерождения №n (n с 0) = LevelBase + n × LevelStep.
	  Дополнительно можно брать победы: WinsCost (0 = бесплатно).
	После перерождения:
	  • сбрасываются сила, уровень, купленные кирки и прогресс стен;
	  • питомцы, ауры, удача и оставшиеся победы сохраняются;
	  • сила навсегда растёт на StrengthBonusPerRebirth за каждое перерождение
	    (0.25 = +25% к силе за удар);
	  • открываются новые ямы (см. PitConfig).
]]

return {
	LevelBase = 10,
	LevelStep = 10,
	WinsCost = 0,
	StrengthBonusPerRebirth = 0.25,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002261"><Properties>
<string name="Name">RewardsConfig</string>
<ProtectedString name="Source"><![CDATA[--[[
	RewardsConfig — ежедневные награды, ежедневные задания и достижения.

	Stat — какая статистика считается:
	  "Swings" удары в ямах, "LayersBroken" разрушенные слои, "LevelsCleared" пройденные уровни,
	  "EggsOpened" открытые яйца, "OresSold" проданные руды, "Rebirths" перерождения.
	Goal   — сколько нужно.
	Reward — сколько побед дать.
]]

return {
	-- Награда за вход: день 1, день 2 … (после 7-го дня цикл повторяется)
	DailyRewards = { 2, 3, 5, 8, 10, 15, 30 },

	-- Задания обновляются каждый день (по UTC)
	DailyQuests = {
		{ Id = "q_swings", Text = "Сделай 300 ударов в яме", Stat = "Swings", Goal = 300, Reward = 3 },
		{ Id = "q_layers", Text = "Разрушь 30 слоёв стены", Stat = "LayersBroken", Goal = 30, Reward = 5 },
		{ Id = "q_eggs", Text = "Открой 2 яйца", Stat = "EggsOpened", Goal = 2, Reward = 4 },
	},

	Achievements = {
		{ Id = "a_swing1", Text = "1 000 ударов в яме", Stat = "Swings", Goal = 1000, Reward = 5 },
		{ Id = "a_swing2", Text = "10 000 ударов в яме", Stat = "Swings", Goal = 10000, Reward = 30 },
		{ Id = "a_layers1", Text = "Разрушь 100 слоёв", Stat = "LayersBroken", Goal = 100, Reward = 10 },
		{ Id = "a_levels1", Text = "Пройди 10 уровней", Stat = "LevelsCleared", Goal = 10, Reward = 10 },
		{ Id = "a_levels2", Text = "Пройди 100 уровней", Stat = "LevelsCleared", Goal = 100, Reward = 60 },
		{ Id = "a_eggs1", Text = "Открой 10 яиц", Stat = "EggsOpened", Goal = 10, Reward = 15 },
		{ Id = "a_rebirth1", Text = "Первое перерождение", Stat = "Rebirths", Goal = 1, Reward = 10 },
		{ Id = "a_rebirth2", Text = "10 перерождений", Stat = "Rebirths", Goal = 10, Reward = 100 },
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002262"><Properties>
<string name="Name">ShopConfig</string>
<ProtectedString name="Source"><![CDATA[--[[
	ShopConfig — удача и платные покупки (Robux).

	УДАЧА увеличивает шанс выпадения руд: шанс × (1 + удача% / 100).
	В магазине несколько вариантов удачи. Каждый можно покупать много раз,
	после каждой покупки он дорожает в CostGrowth раз.

	ВАЖНО про Robux-покупки:
	Id = 0 означает «ещё не создан». Создайте геймпасс / товар в Creator Dashboard
	(create.roblox.com › ваша игра › Monetization), скопируйте его номер и вставьте вместо 0.
	Пока Id = 0, кнопка покажет сообщение «Покупка ещё не настроена».
]]

return {
	Luck = {
		MaxPercent = 500, -- максимум удачи в процентах
		CostGrowth = 1.3,
		Offers = {
			{ Id = "small", Name = "Малая удача", Percent = 5, Price = 10, Emoji = "🍀" },
			{ Id = "medium", Name = "Средняя удача", Percent = 15, Price = 25, Emoji = "🍀" },
			{ Id = "big", Name = "Большая удача", Percent = 40, Price = 60, Emoji = "🌟" },
			{ Id = "mega", Name = "Мега удача", Percent = 100, Price = 140, Emoji = "💎" },
		},
	},

	-- Геймпассы (покупаются один раз навсегда)
	GamePasses = {
		WinsX3 = { Id = 0, Name = "×3 Победы", Description = "Награда за уровни всегда ×3", Icon = "PassWinsX3" },
		StrengthX2 = { Id = 0, Name = "×2 Сила", Description = "Вся сила за удар ×2", Icon = "PassStrengthX2" },
		LuckX2 = { Id = 0, Name = "×2 Удача", Description = "Удача ×2", Icon = "PassLuckX2" },
		AutoClick = { Id = 0, Name = "Автоклик", Description = "Кирка бьёт сама", Icon = "PassAutoClick" },
	},
	GamePassOrder = { "WinsX3", "StrengthX2", "LuckX2", "AutoClick" },

	-- Товары разработчика (можно покупать много раз)
	-- Hidden = true — не показывается в магазине (покупается через отдельную кнопку в игре)
	Products = {
		{ Key = "wins_small", Id = 0, Name = "+50 побед", Wins = 50 },
		{ Key = "wins_big", Id = 0, Name = "+500 побед", Wins = 500 },
		{ Key = "luck_robux", Id = 0, Name = "+50% удачи", LuckPercent = 50 },
		{ Key = "spin", Id = 0, Name = "Вращение колеса", Spins = 1 },
		{ Key = "level_x3", Id = 0, Name = "×3 награда за уровень", Hidden = true },
		-- Пакеты опыта (кнопки под полосой уровня). XpFactor — сколько «уровней» опыта:
		-- опыт = опыт, нужный для текущего уровня × XpFactor
		{ Key = "xp_small", Id = 0, Name = "Опыт: малый", XpFactor = 0.5, Hidden = true },
		{ Key = "xp_medium", Id = 0, Name = "Опыт: средний", XpFactor = 3, Hidden = true },
		{ Key = "xp_big", Id = 0, Name = "Опыт: большой", XpFactor = 15, Hidden = true },
		-- Яйца за Robux (PetConfig → RobuxProduct)
		{ Key = "egg_divine", Id = 0, Name = "Божественное яйцо", Hidden = true },
		{ Key = "egg_devil", Id = 0, Name = "Дьявольское яйцо", Hidden = true },
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002263"><Properties>
<string name="Name">TextureConfig</string>
<ProtectedString name="Source"><![CDATA[--[[
	TextureConfig — пиксельные текстуры карты (файлы в папке art/textures).

	Как включить:
	1) Studio › View › Asset Manager › Bulk Import → выберите PNG из art/textures.
	2) Правый клик по картинке → Copy Asset ID → вставьте сюда вместо 0.
	3) Нажмите Play — текстуры появятся на стенах, полу, ямах и слоях стен.

	Чтобы текстуры были видны и в Studio без запуска игры (и их можно было двигать/удалять):
	View › Command Bar → вставьте строку и нажмите Enter:
	  require(game.ReplicatedStorage.Shared.TextureApplier).Apply()

	StudsPerTile — размер одной плитки текстуры в стадах (больше = крупнее рисунок).
]]

return {
	StudsPerTile = 6,
	Textures = {
		brick = "rbxassetid://0", -- brick.png (стены)
		grass_top = "rbxassetid://0", -- grass_top.png
		grass_side = "rbxassetid://0", -- grass_side.png
		floor_tiles = "rbxassetid://0", -- floor_tiles.png (пол лобби)
		floor_dark = "rbxassetid://0", -- floor_dark.png (пол уровней)
		stone_brick = "rbxassetid://0", -- stone_brick.png (арка, ступени магазина)
		dirt = "rbxassetid://0", -- dirt.png (Землянка)
	},
	-- Текстуры слоёв стен по номеру уровня
	Levels = {
		"rbxassetid://0", -- 1 level_hay.png
		"rbxassetid://0", -- 2 level_wood.png
		"rbxassetid://0", -- 3 level_coal.png
		"rbxassetid://0", -- 4 level_stone.png
		"rbxassetid://0", -- 5 level_copper.png
		"rbxassetid://0", -- 6 level_iron.png
		"rbxassetid://0", -- 7 level_gold.png
		"rbxassetid://0", -- 8 level_obsidian.png
		"rbxassetid://0", -- 9 level_diamond.png
		"rbxassetid://0", -- 10 level_netherite.png
	},
	-- Текстуры ям по номеру (Pit_01 …): ключ из Textures или номер уровня из Levels
	Pits = { "dirt", 3, 4, 6, 7, 9, 8 },
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002264"><Properties>
<string name="Name">WheelConfig</string>
<ProtectedString name="Source"><![CDATA[--[[
	WheelConfig — колесо фортуны.

	Cooldown — через сколько секунд даётся бесплатное вращение.
	Prizes   — сектора колеса по кругу (по часовой стрелке, начиная сверху).
	  Type: "Wins" (победы), "StrengthPercent" (+% к текущей силе), "Luck" (+% удачи),
	        "Aura" (аура по Id из AuraConfig).
	  Weight — вес шанса (больше = чаще).
]]

return {
	Cooldown = 30 * 60, -- бесплатное вращение раз в 30 минут; потом — за Robux (ShopConfig, товар "spin")
	Prizes = {
		{ Text = "+5 побед", Type = "Wins", Amount = 5, Weight = 30, Color = Color3.fromRGB(255, 77, 109) },
		{ Text = "+25% силы", Type = "StrengthPercent", Amount = 25, Weight = 22, Color = Color3.fromRGB(255, 210, 63) },
		{ Text = "+15 побед", Type = "Wins", Amount = 15, Weight = 15, Color = Color3.fromRGB(61, 220, 132) },
		{ Text = "+5% удачи", Type = "Luck", Amount = 5, Weight = 12, Color = Color3.fromRGB(63, 169, 255) },
		{ Text = "+50 побед", Type = "Wins", Amount = 50, Weight = 6, Color = Color3.fromRGB(166, 91, 255) },
		{ Text = "+100% силы", Type = "StrengthPercent", Amount = 100, Weight = 8, Color = Color3.fromRGB(255, 138, 61) },
		{ Text = "Аура Радуга", Type = "Aura", AuraId = "rainbow", Weight = 2, Color = Color3.fromRGB(255, 95, 210) },
		{ Text = "+15% удачи", Type = "Luck", Amount = 15, Weight = 5, Color = Color3.fromRGB(51, 224, 208) },
	},
}
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX002265"><Properties>
<string name="Name">Shared</string>
</Properties>
<Item class="ModuleScript" referent="RBX002266"><Properties>
<string name="Name">Catalog</string>
<ProtectedString name="Source"><![CDATA[-- Catalog — быстрый поиск записей в конфигах по Id (общий для сервера и клиента)
local Config = script.Parent.Parent:WaitForChild("Config")

local PickaxeConfig = require(Config:WaitForChild("PickaxeConfig"))
local PetConfig = require(Config:WaitForChild("PetConfig"))
local AuraConfig = require(Config:WaitForChild("AuraConfig"))
local LevelConfig = require(Config:WaitForChild("LevelConfig"))
local OreConfig = require(Config:WaitForChild("OreConfig"))

local Catalog = {}

local function index(list)
	local map = {}
	for i, item in ipairs(list) do
		map[item.Id] = item
		item._Index = i
	end
	return map
end

Catalog.Pickaxes = index(PickaxeConfig.Pickaxes)
Catalog.Auras = index(AuraConfig.Auras)
Catalog.Levels = index(LevelConfig.Levels)
Catalog.Ores = index(OreConfig.Ores)
Catalog.Eggs = index(PetConfig.Eggs)
Catalog.Pets = PetConfig.Pets

function Catalog.Pickaxe(id: string?)
	return (id and Catalog.Pickaxes[id]) or PickaxeConfig.Pickaxes[1]
end

function Catalog.Level(id: number)
	return Catalog.Levels[id]
end

return Catalog
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002267"><Properties>
<string name="Name">Format</string>
<ProtectedString name="Source"><![CDATA[-- Format — красивый вывод чисел: 1250 → "1.25K", 3190 → "3,190"
local Format = {}

local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Short(n: number): string
	n = tonumber(n) or 0
	if math.abs(n) < 1000 then
		if n == math.floor(n) then
			return tostring(math.floor(n))
		end
		local d = string.format("%.2f", n):gsub("0+$", ""):gsub("%.$", "")
		return d -- 1.2, 7.5, 12.5
	end
	local i = 0
	while math.abs(n) >= 1000 and i < #SUFFIXES do
		n /= 1000
		i += 1
	end
	local s = string.format(n >= 100 and "%.0f" or (n >= 10 and "%.1f" or "%.2f"), n)
	if s:find("%.") then
		s = s:gsub("0+$", ""):gsub("%.$", "")
	end
	return s .. SUFFIXES[i]
end

-- С разделителями тысяч (до миллиона), дальше — короткий вид
function Format.Comma(n: number): string
	n = math.floor(tonumber(n) or 0)
	if math.abs(n) >= 1e6 then
		return Format.Short(n)
	end
	local s = tostring(math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	out = out:gsub("^,", "")
	return (n < 0 and "-" or "") .. out
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

return Format
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002268"><Properties>
<string name="Name">Formulas</string>
<ProtectedString name="Source"><![CDATA[-- Formulas — все игровые формулы в одном месте (используются и сервером, и интерфейсом)
local Config = script.Parent.Parent:WaitForChild("Config")
local LevelConfig = require(Config:WaitForChild("LevelConfig"))
local Settings = require(Config:WaitForChild("GameSettings"))
local RebirthConfig = require(Config:WaitForChild("RebirthConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local Catalog = require(script.Parent:WaitForChild("Catalog"))

local Formulas = {}

-- Надетые питомцы складываются: x1.2 + x1.5 = x2.7 (без питомцев — x1)
function Formulas.PetMultiplier(data): number
	local m = 0
	local byUid = {}
	for _, pet in ipairs(data.Pets or {}) do
		byUid[pet.Uid] = pet
	end
	for _, uid in ipairs(data.EquippedPets or {}) do
		local pet = byUid[uid]
		local def = pet and Catalog.Pets[pet.Id]
		if def then
			m += def.Multiplier or 0
		end
	end
	return math.max(1, m)
end

function Formulas.AuraMultiplier(data): number
	local aura = data.EquippedAura and Catalog.Auras[data.EquippedAura]
	return aura and aura.Multiplier or 1
end

function Formulas.RebirthMultiplier(data): number
	return 1 + (data.Rebirths or 0) * RebirthConfig.StrengthBonusPerRebirth
end

function Formulas.PickaxePower(data): number
	return Catalog.Pickaxe(data.EquippedPickaxe).Power
end

-- Общий множитель силы (без ямы)
function Formulas.TotalMultiplier(data, hasStrengthPass: boolean?): number
	return Formulas.PickaxePower(data)
		* Formulas.PetMultiplier(data)
		* Formulas.AuraMultiplier(data)
		* Formulas.RebirthMultiplier(data)
		* (hasStrengthPass and 2 or 1)
end

-- Сила за один удар в яме
function Formulas.StrengthPerSwing(data, pitPower: number, hasStrengthPass: boolean?): number
	return math.max(1, math.floor(pitPower * Settings.StrengthMultiplier * Formulas.TotalMultiplier(data, hasStrengthPass) + 0.5))
end

-- Урон по стене за удар = текущая сила (минимум 1)
function Formulas.Damage(data): number
	return math.max(1, data.Strength or 0)
end

function Formulas.LayerHP(levelId: number, layer: number): number
	local level = Catalog.Level(levelId)
	if not level then
		return math.huge
	end
	return math.floor(level.BaseHP * (1 + (layer - 1) * LevelConfig.LayerHPStep))
end

function Formulas.RecommendedStrength(levelId: number): number
	local level = Catalog.Level(levelId)
	return level and math.ceil(level.BaseHP / LevelConfig.TargetHitsPerLayer) or 0
end

function Formulas.RebirthCost(_rebirths: number): number
	return RebirthConfig.WinsCost or 0
end

-- Какой уровень игрока нужен для следующего перерождения
function Formulas.RebirthLevel(rebirths: number): number
	return RebirthConfig.LevelBase + rebirths * RebirthConfig.LevelStep
end

-- Сколько опыта нужно, чтобы с уровня level перейти на следующий
function Formulas.XpForLevel(level: number): number
	return math.floor(Settings.Xp.Base * level ^ Settings.Xp.Growth)
end

-- Цена варианта удачи с учётом того, сколько раз он уже куплен
function Formulas.LuckOfferCost(offer, timesBought: number): number
	return math.floor(offer.Price * ShopConfig.Luck.CostGrowth ^ (timesBought or 0))
end

function Formulas.LuckPercent(data, hasLuckPass: boolean?): number
	local p = data.LuckPercent or 0
	if hasLuckPass then
		p = (p + 100) * 2 - 100 -- удача ×2: множитель шанса удваивается
	end
	return p
end

return Formulas
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002269"><Properties>
<string name="Name">Remotes</string>
<ProtectedString name="Source"><![CDATA[-- Remotes — сетевые события между сервером и клиентом.
-- Сервер создаёт их при старте, клиент ждёт.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Swing", -- клиент → сервер: удар киркой
	"DataUpdate", -- сервер → клиент: данные игрока
	"LevelState", -- сервер → клиент: уровень/слой/прочность
	"Notify", -- сервер → клиент: всплывающее сообщение
	"Effect", -- сервер → клиент: эффекты (сила, обломки)
}
local FUNCTIONS = {
	"Request", -- клиент → сервер: покупки и действия (с ответом)
}

local Remotes = {}
local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder
	end
	if RunService:IsServer() then
		local f = ReplicatedStorage:FindFirstChild("Remotes")
		if not f then
			f = Instance.new("Folder")
			f.Name = "Remotes"
			f.Parent = ReplicatedStorage
		end
		for _, name in ipairs(EVENTS) do
			if not f:FindFirstChild(name) then
				local e = Instance.new("RemoteEvent")
				e.Name = name
				e.Parent = f
			end
		end
		for _, name in ipairs(FUNCTIONS) do
			if not f:FindFirstChild(name) then
				local e = Instance.new("RemoteFunction")
				e.Name = name
				e.Parent = f
			end
		end
		folder = f
	else
		folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	return folder :: Folder
end

function Remotes.Event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002270"><Properties>
<string name="Name">TextureApplier</string>
<ProtectedString name="Source"><![CDATA[--[[
	TextureApplier — накладывает пиксельные текстуры (TextureConfig) на детали карты.
	Запускается автоматически у каждого игрока. Можно запустить и в Studio из Command Bar:
	  require(game.ReplicatedStorage.Shared.TextureApplier).Apply()
	тогда текстуры станут обычными объектами Texture внутри деталей.
]]
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TextureConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("TextureConfig"))

local TextureApplier = {}
local ALL = { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Top, Enum.NormalId.Bottom }
local SIDES = { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }
local TOP = { Enum.NormalId.Top }

local function valid(id: string?): boolean
	return type(id) == "string" and id ~= "" and id ~= "rbxassetid://0"
end

local function add(part: Instance?, id: string?, faces, tileU: number?, tileV: number?)
	if not part or not part:IsA("BasePart") or not valid(id) then
		return
	end
	for _, face in ipairs(faces) do
		local name = "AutoTexture_" .. face.Name
		if not part:FindFirstChild(name) then
			local t = Instance.new("Texture")
			t.Name = name
			t.Texture = id :: string
			t.Face = face
			t.StudsPerTileU = tileU or TextureConfig.StudsPerTile
			t.StudsPerTileV = tileV or TextureConfig.StudsPerTile
			t.Parent = part
		end
	end
end

local function tex(key: string): string?
	return TextureConfig.Textures[key]
end

local function grassCap(part: Instance)
	add(part, tex("grass_top"), TOP, 4, 4)
	if part:IsA("BasePart") then
		add(part, tex("grass_side"), SIDES, 4, part.Size.Y)
	end
end

local function each(folder: Instance?, fn)
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			fn(child)
		end
	end
end

function TextureApplier.Apply()
	local map = Workspace:FindFirstChild("Map")
	if not map then
		return
	end
	local hub = map:FindFirstChild("Hub")
	if hub then
		each(hub:FindFirstChild("Floor"), function(p)
			add(p, tex("floor_tiles"), TOP, 8, 8)
		end)
		each(hub:FindFirstChild("Walls"), function(p)
			if p.Name:sub(1, 5) == "Grass" then
				grassCap(p)
			else
				add(p, tex("brick"), ALL)
			end
		end)
		local entrance = hub:FindFirstChild("LevelEntrance")
		each(entrance, function(p)
			if p.Name:match("^Pillar") or p.Name == "Lintel" then
				add(p, tex("stone_brick"), ALL, 4, 4)
			end
		end)
		local shop = hub:FindFirstChild("PickaxeShop")
		each(shop and shop:FindFirstChild("Steps"), function(p)
			if p.Name:match("^Row") or p.Name:match("^Stair") then
				add(p, tex("stone_brick"), SIDES, 4, 4)
				add(p, tex("floor_tiles"), TOP, 8, 8)
			end
		end)
		each(hub:FindFirstChild("Pits"), function(pit)
			local n = tonumber(pit.Name:match("(%d+)$"))
			local key = n and TextureConfig.Pits[n]
			local id = type(key) == "number" and TextureConfig.Levels[key] or (type(key) == "string" and tex(key) or nil)
			if id then
				add(pit:FindFirstChild("PitFloor"), id, TOP, 4, 4)
				for _, side in ipairs({ "WallN", "WallS", "WallW", "WallE" }) do
					add(pit:FindFirstChild(side), id, ALL, 4, 4)
				end
			end
		end)
	end

	each(map:FindFirstChild("Levels"), function(level)
		local n = tonumber(level.Name:match("(%d+)$"))
		each(level:FindFirstChild("Structure"), function(p)
			if p.Name:match("^Grass") then
				grassCap(p)
			elseif p.Name == "Floor" or p.Name == "NicheFloor" then
				add(p, tex("floor_dark"), TOP, 8, 8)
			elseif p.Name:match("^Wall") or p.Name:match("^Niche") or p.Name == "EndWall" then
				add(p, tex("brick"), ALL)
			end
		end)
		local id = n and TextureConfig.Levels[n]
		each(level:FindFirstChild("Wall"), function(layer)
			add(layer, id, ALL, 6, 6)
		end)
	end)

	local ground = map:FindFirstChild("Ground")
	each(ground, function(p)
		if p:IsA("BasePart") then
			add(p, tex("grass_top"), TOP, 8, 8)
		end
	end)
	each(ground and ground:FindFirstChild("Terraces"), function(block)
		add(block:FindFirstChild("Brick"), tex("brick"), ALL)
		local g = block:FindFirstChild("Grass")
		if g then
			grassCap(g)
		end
	end)
end

return TextureApplier
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX002271"><Properties>
<string name="Name">PetModels</string>
</Properties>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX002272"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX002273"><Properties>
<string name="Name">Main</string>
<ProtectedString name="Source"><![CDATA[--[[
	Main — запуск серверных систем.
	Каждая система — отдельный модуль в папке Services.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
Remotes.Event("Swing") -- создаём папку Remotes до запуска остального

local Services = script.Parent:WaitForChild("Services")
local ORDER = {
	"DataService",
	"RequestService",
	"MonetizationService",
	"MapService",
	"BoostService",
	"PickaxeService",
	"TrainingService",
	"OreService",
	"WallService",
	"PetService",
	"AuraService",
	"RebirthService",
	"WheelService",
	"DailyService",
	"SwingService",
}

local modules = {}
for _, name in ipairs(ORDER) do
	modules[name] = require(Services:WaitForChild(name))
end
-- Сначала подключаем обработчики, потом DataService начинает загружать игроков
for _, name in ipairs(ORDER) do
	if name ~= "DataService" and modules[name].Init then
		modules[name].Init()
	end
end
modules.DataService.Init()
print("[WallBreaker] Сервер запущен")
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX002274"><Properties>
<string name="Name">Services</string>
</Properties>
<Item class="ModuleScript" referent="RBX002275"><Properties>
<string name="Name">AuraService</string>
<ProtectedString name="Source"><![CDATA[--[[
	AuraService — покупка и надевание аур, светящийся эффект вокруг игрока.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared:WaitForChild("Catalog"))
local Format = require(Shared:WaitForChild("Format"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local RequestService = require(Services:WaitForChild("RequestService"))

local AuraService = {}

function AuraService.ApplyVisual(player: Player)
	local data = DataService.Get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not data or not root then
		return
	end
	local old = root:FindFirstChild("AuraFx")
	if old then
		old:Destroy()
	end
	local aura = Catalog.Auras[data.EquippedAura]
	if not aura then
		return
	end
	local att = Instance.new("Attachment")
	att.Name = "AuraFx"
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(aura.Color)
	emitter.LightEmission = 1
	emitter.Rate = 30
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Speed = NumberRange.new(1, 3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Parent = att
	local light = Instance.new("PointLight")
	light.Color = aura.Color
	light.Range = 10
	light.Brightness = 1.5
	light.Parent = att
	att.Parent = root
end

function AuraService.Grant(player: Player, id: string): boolean
	local data = DataService.Get(player)
	if not data or not Catalog.Auras[id] then
		return false
	end
	if data.Auras[id] then
		return false
	end
	data.Auras[id] = true
	DataService.MarkDirty(player)
	return true
end

function AuraService.Init()
	RequestService.Register("BuyAura", function(player, id)
		local data = DataService.Get(player)
		local aura = type(id) == "string" and Catalog.Auras[id]
		if not aura then
			return { ok = false }
		end
		if data.Auras[id] then
			return { ok = false, msg = "Уже куплено" }
		end
		if aura.Price <= 0 then
			return { ok = false, msg = "Эту ауру можно выиграть только в колесе фортуны" }
		end
		if data.Wins < aura.Price then
			return { ok = false, msg = ("Нужно %s побед"):format(Format.Short(aura.Price)) }
		end
		data.Wins -= aura.Price
		data.Auras[id] = true
		data.EquippedAura = id
		DataService.MarkDirty(player)
		AuraService.ApplyVisual(player)
		RequestService.Notify(player, "Аура «" .. aura.Name .. "» надета", "success")
		return { ok = true }
	end)

	RequestService.Register("EquipAura", function(player, id)
		local data = DataService.Get(player)
		if id == "" then
			data.EquippedAura = ""
		elseif type(id) == "string" and data.Auras[id] then
			data.EquippedAura = id
		else
			return { ok = false }
		end
		DataService.MarkDirty(player)
		AuraService.ApplyVisual(player)
		return { ok = true }
	end)

	DataService.OnLoaded(function(player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 5)
			AuraService.ApplyVisual(player)
		end)
		AuraService.ApplyVisual(player)
	end)
end

return AuraService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002276"><Properties>
<string name="Name">BoostService</string>
<ProtectedString name="Source"><![CDATA[--[[
	BoostService — «Мощный удар»: на время вся сила и урон умножаются.
	Настройки: GameSettings.PowerStrike (Multiplier, Duration, Cooldown).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Settings = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("GameSettings"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local RequestService = require(Services:WaitForChild("RequestService"))

local BoostService = {}
local activatedAt: { [Player]: number } = {}

function BoostService.Multiplier(player: Player): number
	local t = activatedAt[player]
	if t and os.clock() - t < Settings.PowerStrike.Duration then
		return Settings.PowerStrike.Multiplier
	end
	return 1
end

function BoostService.Init()
	RequestService.Register("PowerStrike", function(player)
		local t = activatedAt[player]
		local since = t and os.clock() - t or math.huge
		if since < Settings.PowerStrike.Cooldown then
			return { ok = false, msg = ("Мощный удар будет готов через %d сек."):format(math.ceil(Settings.PowerStrike.Cooldown - since)) }
		end
		activatedAt[player] = os.clock()
		DataService.MarkDirty(player)
		RequestService.Notify(player, ("Мощный удар! Сила ×%s на %d сек."):format(tostring(Settings.PowerStrike.Multiplier), Settings.PowerStrike.Duration), "success")
		return { ok = true }
	end)

	DataService.AddStateHook(function(player, state)
		local t = activatedAt[player]
		local since = t and os.clock() - t or math.huge
		state.PowerStrikeActiveFor = math.max(0, Settings.PowerStrike.Duration - since)
		state.PowerStrikeReadyIn = math.max(0, Settings.PowerStrike.Cooldown - since)
	end)

	Players.PlayerRemoving:Connect(function(p)
		activatedAt[p] = nil
	end)
end

return BoostService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002277"><Properties>
<string name="Name">DailyService</string>
<ProtectedString name="Source"><![CDATA[--[[
	DailyService — ежедневные награды, ежедневные задания и достижения (RewardsConfig).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local RewardsConfig = require(Config:WaitForChild("RewardsConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local RequestService = require(Services:WaitForChild("RequestService"))

local DailyService = {}
local DAY = 86400

local function today(): number
	return math.floor(os.time() / DAY)
end

-- Каждый новый день задания начинаются с нуля (запоминаем статистику на начало дня)
local function ensureQuestDay(data)
	if data.Quests.Day ~= today() then
		data.Quests.Day = today()
		data.Quests.Base = table.clone(data.Stats)
		data.Quests.Claimed = {}
	end
end

local function questProgress(data, quest): number
	return (data.Stats[quest.Stat] or 0) - (data.Quests.Base[quest.Stat] or 0)
end

function DailyService.Init()
	RequestService.Register("ClaimDaily", function(player)
		local data = DataService.Get(player)
		local now = os.time()
		local since = now - data.Daily.LastClaim
		if since < DAY then
			return { ok = false, msg = "Следующая награда через " .. Format.Time(DAY - since) }
		end
		local streak = (since < DAY * 2) and data.Daily.Streak + 1 or 1
		local list = RewardsConfig.DailyRewards
		local reward = list[((streak - 1) % #list) + 1]
		data.Daily.LastClaim = now
		data.Daily.Streak = streak
		data.Wins += reward
		DataService.MarkDirty(player)
		RequestService.Notify(player, ("День %d: +%s побед"):format(streak, Format.Short(reward)), "wins")
		return { ok = true }
	end)

	RequestService.Register("ClaimQuest", function(player, id)
		local data = DataService.Get(player)
		ensureQuestDay(data)
		for _, quest in ipairs(RewardsConfig.DailyQuests) do
			if quest.Id == id then
				if data.Quests.Claimed[id] then
					return { ok = false, msg = "Уже получено" }
				end
				if questProgress(data, quest) < quest.Goal then
					return { ok = false, msg = "Задание ещё не выполнено" }
				end
				data.Quests.Claimed[id] = true
				data.Wins += quest.Reward
				DataService.MarkDirty(player)
				RequestService.Notify(player, ("Задание выполнено: +%s побед"):format(Format.Short(quest.Reward)), "wins")
				return { ok = true }
			end
		end
		return { ok = false }
	end)

	RequestService.Register("ClaimAchievement", function(player, id)
		local data = DataService.Get(player)
		for _, ach in ipairs(RewardsConfig.Achievements) do
			if ach.Id == id then
				if data.Achievements[id] then
					return { ok = false, msg = "Уже получено" }
				end
				if (data.Stats[ach.Stat] or 0) < ach.Goal then
					return { ok = false, msg = "Ещё не выполнено" }
				end
				data.Achievements[id] = true
				data.Wins += ach.Reward
				DataService.MarkDirty(player)
				RequestService.Notify(player, ("Достижение: +%s побед"):format(Format.Short(ach.Reward)), "wins")
				return { ok = true }
			end
		end
		return { ok = false }
	end)

	DataService.OnLoaded(function(player, data)
		ensureQuestDay(data)
		DataService.MarkDirty(player)
	end)

	DataService.AddStateHook(function(_, state, data)
		ensureQuestDay(data)
		local quests = {}
		for _, quest in ipairs(RewardsConfig.DailyQuests) do
			quests[quest.Id] = math.max(0, questProgress(data, quest))
		end
		state.QuestProgress = quests
		state.QuestResetIn = (today() + 1) * DAY - os.time()
		state.DailyReadyIn = math.max(0, DAY - (os.time() - data.Daily.LastClaim))
	end)
end

return DailyService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002278"><Properties>
<string name="Name">DataService</string>
<ProtectedString name="Source"><![CDATA[--[[
	DataService — загрузка, хранение и сохранение данных игроков (DataStoreService).

	Чтобы сохранение работало в Studio: Home › Game Settings › Security ›
	включите «Enable Studio Access to API Services» (игра должна быть опубликована).
]]
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("GameSettings"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Format"))

local DataService = {}

local profiles: { [Player]: any } = {}
local dirty: { [Player]: boolean } = {}
local loadedCallbacks = {}
local stateHooks = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Settings.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore недоступен, прогресс не будет сохраняться:", result)
	end
end

-- Шаблон данных нового игрока. Новые поля можно добавлять — у старых игроков они появятся сами.
local function makeTemplate()
	return {
		Version = 1,
		Wins = Settings.StartWins,
		Strength = Settings.StartStrength,
		Rebirths = 0,
		PlayerLevel = 1, -- уровень игрока (качается в ямах)
		Xp = 0,
		LuckPercent = 0, -- купленная удача в процентах
		LuckBought = {}, -- { [offerId] = сколько раз куплено }
		PendingX3Level = 0,
		OwnedPickaxes = { [Settings.StartPickaxe] = true },
		EquippedPickaxe = Settings.StartPickaxe,
		Pets = {}, -- { {Uid = 1, Id = "dog"}, ... }
		EquippedPets = {}, -- { Uid, Uid, ... }
		NextPetUid = 1,
		Auras = {}, -- { [auraId] = true }
		EquippedAura = "",
		Ores = {}, -- { [oreId] = количество }
		LevelProgress = {}, -- { ["1"] = сломано слоёв }
		BestLevel = 0,
		Stats = { Swings = 0, LayersBroken = 0, LevelsCleared = 0, EggsOpened = 0, OresSold = 0, Rebirths = 0 },
		Daily = { LastClaim = 0, Streak = 0 },
		Quests = { Day = -1, Base = {}, Claimed = {} },
		Achievements = {}, -- { [id] = true }
		Wheel = { LastFree = 0, ExtraSpins = 0 },
		Purchases = {}, -- { [PurchaseId] = время }
		Settings = { AutoClick = true, ShowPets = true },
	}
end

local function deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in pairs(t) do
		c[k] = deepCopy(v)
	end
	return c
end

local function isArray(t)
	return type(t) == "table" and #t > 0
end

local function reconcile(target, template)
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" and not isArray(v) and next(v) ~= nil then
			reconcile(target[k], v)
		end
	end
end

local function makeLeaderstats(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local wins = Instance.new("IntValue")
	wins.Name = "Победы"
	wins.Parent = ls
	local strength = Instance.new("StringValue")
	strength.Name = "Сила"
	strength.Parent = ls
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Перерождения"
	rebirths.Parent = ls
	ls.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	local wins = ls:FindFirstChild("Победы") :: IntValue?
	local strength = ls:FindFirstChild("Сила") :: StringValue?
	local rebirths = ls:FindFirstChild("Перерождения") :: IntValue?
	if wins then
		wins.Value = math.min(data.Wins, 2 ^ 53)
	end
	if strength then
		strength.Value = Format.Short(data.Strength)
	end
	if rebirths then
		rebirths.Value = data.Rebirths
	end
end

-- Тестовый режим: бесконечные победы и сила (см. GameSettings.Infinite)
function DataService.IsInfinite(player: Player): boolean
	local inf = Settings.Infinite
	if not inf then
		return false
	end
	if inf.InStudio and RunService:IsStudio() then
		return true
	end
	if inf.ForOwner and game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	return table.find(inf.UserIds or {}, player.UserId) ~= nil
end

function DataService.Get(player: Player)
	return profiles[player]
end

function DataService.MarkDirty(player: Player)
	if profiles[player] then
		dirty[player] = true
	end
end

-- Сервисы добавляют в отправляемое клиенту состояние свои поля
function DataService.AddStateHook(fn)
	table.insert(stateHooks, fn)
end

-- Вызвать fn(player, data), когда данные игрока загружены
function DataService.OnLoaded(fn)
	table.insert(loadedCallbacks, fn)
	for player, data in pairs(profiles) do
		task.spawn(fn, player, data)
	end
end

function DataService.AddWins(player: Player, amount: number)
	local data = profiles[player]
	if data then
		data.Wins += amount
		DataService.MarkDirty(player)
	end
end

function DataService.AddStat(player: Player, stat: string, amount: number)
	local data = profiles[player]
	if data then
		data.Stats[stat] = (data.Stats[stat] or 0) + amount
	end
end

local function push(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	local state = { Data = data, ServerTime = os.time() }
	for _, hook in ipairs(stateHooks) do
		local ok, err = pcall(hook, player, state, data)
		if not ok then
			warn("[DataService] state hook:", err)
		end
	end
	Remotes.Event("DataUpdate"):FireClient(player, state)
	updateLeaderstats(player, data)
end

function DataService.Load(player: Player)
	local key = "u_" .. player.UserId
	local data = nil
	local loadedOk = store == nil -- без DataStore работаем с пустыми данными
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(key)
			end)
			if ok then
				data = result
				loadedOk = true
				break
			end
			warn(("[DataService] Загрузка %s, попытка %d: %s"):format(player.Name, attempt, tostring(result)))
			task.wait(2)
		end
	end
	if not loadedOk then
		-- Не перезаписываем сохранение пустыми данными
		player:Kick("Не удалось загрузить прогресс. Пожалуйста, перезайдите.")
		return
	end
	if not player.Parent then
		return
	end
	if type(data) ~= "table" then
		data = makeTemplate()
		if RunService:IsStudio() and Settings.StudioTestWins > 0 then
			data.Wins = Settings.StudioTestWins
		end
	end
	reconcile(data, makeTemplate())
	-- перенос старой удачи (уровни → проценты)
	if type(data.LuckLevel) == "number" and data.LuckLevel > 0 then
		data.LuckPercent += data.LuckLevel * 4
		data.LuckLevel = nil
	end
	profiles[player] = data
	if DataService.IsInfinite(player) then
		player:SetAttribute("Infinite", true)
		data.Wins = math.max(data.Wins, Settings.Infinite.Amount)
		data.Strength = math.max(data.Strength, Settings.Infinite.Amount)
	end
	makeLeaderstats(player)
	for _, cb in ipairs(loadedCallbacks) do
		task.spawn(cb, player, data)
	end
	DataService.MarkDirty(player)
end

function DataService.Save(player: Player): boolean
	local data = profiles[player]
	if not data or not store or player:GetAttribute("Infinite") then
		return false -- тестовые игроки с бесконечными ресурсами не сохраняются
	end
	local key = "u_" .. player.UserId
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key, function()
				return data
			end)
		end)
		if ok then
			return true
		end
		warn(("[DataService] Сохранение %s, попытка %d: %s"):format(player.Name, attempt, tostring(err)))
		task.wait(1)
	end
	return false
end

function DataService.Init()
	Players.PlayerAdded:Connect(DataService.Load)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(DataService.Load, p)
	end

	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		profiles[player] = nil
		dirty[player] = nil
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				DataService.Save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)

	-- Отправка изменений клиенту не чаще 5 раз в секунду
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		for player in pairs(dirty) do
			dirty[player] = nil
			push(player)
		end
	end)

	-- Бесконечные ресурсы: пополняем
	task.spawn(function()
		while true do
			task.wait(1)
			for player, data in pairs(profiles) do
				if player:GetAttribute("Infinite") then
					if data.Wins < Settings.Infinite.Amount or data.Strength < Settings.Infinite.Amount then
						data.Wins = math.max(data.Wins, Settings.Infinite.Amount)
						data.Strength = math.max(data.Strength, Settings.Infinite.Amount)
						DataService.MarkDirty(player)
					end
				end
			end
		end
	end)

	-- Автосохранение
	task.spawn(function()
		while true do
			task.wait(Settings.AutoSaveInterval)
			for player in pairs(profiles) do
				task.spawn(DataService.Save, player)
			end
		end
	end)
end

return DataService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002279"><Properties>
<string name="Name">MapService</string>
<ProtectedString name="Source"><![CDATA[--[[
	MapService — находит объекты карты по именам в Workspace › Map.
	Объекты можно свободно двигать, масштабировать и перекрашивать в Studio —
	скрипты ищут их по имени, а не по координатам.
]]
local Workspace = game:GetService("Workspace")

local MapService = {}

local function numberFromName(name: string): number?
	return tonumber(name:match("(%d+)$"))
end

local function sortedChildren(folder: Instance?, prefix: string)
	local list = {}
	if not folder then
		return list
	end
	for _, child in ipairs(folder:GetChildren()) do
		if child.Name:sub(1, #prefix) == prefix then
			local n = numberFromName(child.Name)
			if n then
				table.insert(list, { Index = n, Instance = child })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Index < b.Index
	end)
	return list
end

function MapService.Root(): Instance
	return Workspace:WaitForChild("Map")
end

function MapService.Hub(): Instance
	return MapService.Root():WaitForChild("Hub")
end

-- Точка внутри (повёрнутого) блока?
function MapService.PointInPart(part: BasePart, pos: Vector3, padding: number?): boolean
	local p = padding or 0
	local rel = part.CFrame:PointToObjectSpace(pos)
	local half = part.Size / 2
	return math.abs(rel.X) <= half.X + p and math.abs(rel.Y) <= half.Y + p and math.abs(rel.Z) <= half.Z + p
end

local levelsCache = nil
function MapService.Levels()
	if levelsCache then
		return levelsCache
	end
	local result = {}
	for _, entry in ipairs(sortedChildren(MapService.Root():WaitForChild("Levels"), "Level_")) do
		local folder = entry.Instance
		local wallFolder = folder:FindFirstChild("Wall")
		local layers = {}
		for _, l in ipairs(sortedChildren(wallFolder, "Layer_")) do
			layers[l.Index] = l.Instance
		end
		table.insert(result, {
			Id = entry.Index,
			Folder = folder,
			Zone = folder:FindFirstChild("Zone"),
			Layers = layers,
			Sign = folder:FindFirstChild("Sign"),
			RewardPad = folder:FindFirstChild("RewardPad"),
			X3Pad = folder:FindFirstChild("X3Pad"),
			MerchantSpot = folder:FindFirstChild("MerchantSpot"),
		})
	end
	levelsCache = result
	return result
end

function MapService.LevelAt(pos: Vector3)
	for _, level in ipairs(MapService.Levels()) do
		if level.Zone and MapService.PointInPart(level.Zone, pos) then
			return level
		end
	end
	return nil
end

function MapService.Pits()
	local result = {}
	for _, entry in ipairs(sortedChildren(MapService.Hub():FindFirstChild("Pits"), "Pit_")) do
		local model = entry.Instance
		table.insert(result, {
			Index = entry.Index,
			Model = model,
			Zone = model:FindFirstChild("TrainZone"),
			Barrier = model:FindFirstChild("LockBarrier"),
			Sign = model:FindFirstChild("Sign"),
		})
	end
	return result
end

function MapService.PickaxeSlots()
	local shop = MapService.Hub():FindFirstChild("PickaxeShop")
	local result = {}
	for _, entry in ipairs(sortedChildren(shop and shop:FindFirstChild("Slots"), "Slot_")) do
		table.insert(result, { Index = entry.Index, Model = entry.Instance, BuyPad = entry.Instance:FindFirstChild("BuyPad") })
	end
	return result
end

function MapService.Eggs()
	local folder = MapService.Hub():FindFirstChild("Eggs")
	local result = {}
	if folder then
		for _, model in ipairs(folder:GetChildren()) do
			local id = model.Name:match("^Egg_(.+)$")
			if id then
				table.insert(result, { Id = id, Model = model })
			end
		end
	end
	return result
end

function MapService.SpawnCFrame(): CFrame
	local spawn = MapService.Hub():FindFirstChild("SpawnLocation") :: BasePart?
	if spawn then
		return spawn.CFrame + Vector3.new(0, 4, 0)
	end
	return CFrame.new(0, 10, 0)
end

-- Ищет ProximityPrompt внутри объекта
function MapService.FindPrompt(inst: Instance?): ProximityPrompt?
	if not inst then
		return nil
	end
	return inst:FindFirstChildWhichIsA("ProximityPrompt", true)
end

-- Текст в SurfaceGui/BillboardGui по имени TextLabel
function MapService.SetText(inst: Instance?, labelName: string, text: string)
	if not inst then
		return
	end
	local label = inst:FindFirstChild(labelName, true)
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
end

return MapService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002280"><Properties>
<string name="Name">MonetizationService</string>
<ProtectedString name="Source"><![CDATA[--[[
	MonetizationService — геймпассы и товары за Robux (MarketplaceService).
	Номера (Id) задаются в ReplicatedStorage › Config › ShopConfig.
]]
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShopConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("ShopConfig"))
local DataService = require(script.Parent:WaitForChild("DataService"))
local RequestService = require(script.Parent:WaitForChild("RequestService"))

local MonetizationService = {}
local owned: { [Player]: { [string]: boolean } } = {}
local productHandlers = {}

-- Другие сервисы могут обработать свой товар: fn(player, data, product) → true, если выдано
function MonetizationService.RegisterProductHandler(key: string, fn)
	productHandlers[key] = fn
end

function MonetizationService.HasPass(player: Player, key: string): boolean
	return owned[player] ~= nil and owned[player][key] == true
end

local function passKeyById(id: number): string?
	for key, pass in pairs(ShopConfig.GamePasses) do
		if pass.Id ~= 0 and pass.Id == id then
			return key
		end
	end
	return nil
end

local function productById(id: number)
	for _, product in ipairs(ShopConfig.Products) do
		if product.Id ~= 0 and product.Id == id then
			return product
		end
	end
	return nil
end

local function trimPurchases(purchases)
	local count = 0
	local oldestKey, oldestTime = nil, math.huge
	for k, t in pairs(purchases) do
		count += 1
		if t < oldestTime then
			oldestKey, oldestTime = k, t
		end
	end
	if count > 100 and oldestKey then
		purchases[oldestKey] = nil
	end
end

function MonetizationService.Init()
	DataService.OnLoaded(function(player)
		owned[player] = {}
		for key, pass in pairs(ShopConfig.GamePasses) do
			if pass.Id ~= 0 then
				local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
				if ok and has then
					owned[player][key] = true
				end
			end
		end
		DataService.MarkDirty(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
	end)

	DataService.AddStateHook(function(player, state)
		state.Passes = owned[player] or {}
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = passKeyById(passId)
		if key and owned[player] then
			owned[player][key] = true
			DataService.MarkDirty(player)
			RequestService.Notify(player, "Спасибо! Геймпасс «" .. ShopConfig.GamePasses[key].Name .. "» активирован", "success")
		end
	end)

	MarketplaceService.ProcessReceipt = function(info)
		local player = Players:GetPlayerByUserId(info.PlayerId)
		local data = player and DataService.Get(player)
		if not player or not data then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local purchaseId = tostring(info.PurchaseId)
		if data.Purchases[purchaseId] then
			return Enum.ProductPurchaseDecision.PurchaseGranted -- уже выдано (защита от повтора)
		end
		local product = productById(info.ProductId)
		if not product then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local handler = productHandlers[product.Key]
		if handler then
			local ok, granted = pcall(handler, player, data, product)
			if not ok or not granted then
				warn("[Monetization] товар не выдан:", product.Key, granted)
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
		end
		if product.Wins then
			data.Wins += product.Wins
		end
		if product.Spins then
			data.Wheel.ExtraSpins += product.Spins
		end
		if product.LuckPercent then
			data.LuckPercent = math.min(ShopConfig.Luck.MaxPercent, data.LuckPercent + product.LuckPercent)
		end
		data.Purchases[purchaseId] = os.time()
		trimPurchases(data.Purchases)
		DataService.MarkDirty(player)
		if not DataService.Save(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		RequestService.Notify(player, "Покупка получена: " .. product.Name, "success")
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	RequestService.Register("BuyPass", function(player, key)
		local pass = type(key) == "string" and ShopConfig.GamePasses[key]
		if not pass then
			return { ok = false }
		end
		if pass.Id == 0 then
			return { ok = false, msg = "Покупка ещё не настроена (Id = 0 в ShopConfig)" }
		end
		if MonetizationService.HasPass(player, key) then
			return { ok = false, msg = "Уже куплено" }
		end
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
		return { ok = true }
	end)

	RequestService.Register("BuyProduct", function(player, key)
		for _, product in ipairs(ShopConfig.Products) do
			if product.Key == key then
				if product.Id == 0 then
					return { ok = false, msg = "Покупка ещё не настроена (Id = 0 в ShopConfig)" }
				end
				MarketplaceService:PromptProductPurchase(player, product.Id)
				return { ok = true }
			end
		end
		return { ok = false }
	end)
end

return MonetizationService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002281"><Properties>
<string name="Name">OreService</string>
<ProtectedString name="Source"><![CDATA[--[[
	OreService — выпадение руд, торговец в лобби и редкий торговец на уровнях.
	Шаблон редкого торговца: ServerStorage › RareMerchantTemplate (можно перекрасить/заменить).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Config = ReplicatedStorage:WaitForChild("Config")
local OreConfig = require(Config:WaitForChild("OreConfig"))
local Settings = require(Config:WaitForChild("GameSettings"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared:WaitForChild("Formulas"))
local Format = require(Shared:WaitForChild("Format"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local RequestService = require(Services:WaitForChild("RequestService"))
local MapService = require(Services:WaitForChild("MapService"))
local MonetizationService = require(Services:WaitForChild("MonetizationService"))

local OreService = {}
local rng = Random.new()

-- Бросок на выпадение руды после разрушения слоя
function OreService.Roll(player: Player, data)
	local luck = Formulas.LuckPercent(data, MonetizationService.HasPass(player, "LuckX2"))
	local mult = 1 + luck / 100
	for _, ore in ipairs(OreConfig.Ores) do
		if rng:NextNumber() < ore.Chance * mult then
			data.Ores[ore.Id] = (data.Ores[ore.Id] or 0) + 1
			DataService.MarkDirty(player)
			RequestService.Notify(player, "Выпала руда: " .. ore.Name .. "!", "ore:" .. ore.Id)
			return ore
		end
	end
	return nil
end

-- Продать руды. ids = список Id руд (nil — все)
function OreService.SellOres(player: Player, ids: { string }?, multiplier: number)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local total, count = 0, 0
	for id, n in pairs(data.Ores) do
		local ore = Catalog.Ores[id]
		if ore and n > 0 and (ids == nil or table.find(ids, id)) then
			total += ore.Price * n * multiplier
			count += n
			data.Ores[id] = nil
		end
	end
	if count == 0 then
		RequestService.Notify(player, "Нечего продавать. Ломай стены — руды выпадают из слоёв!", "error")
		return
	end
	total = math.floor(total)
	data.Wins += total
	data.Stats.OresSold += count
	DataService.MarkDirty(player)
	RequestService.Notify(player, ("Продано руд: %d → +%s побед"):format(count, Format.Short(total)), "success")
end

local function buildMerchantModel(): Model
	local template = ServerStorage:FindFirstChild("RareMerchantTemplate")
	if template and template:IsA("Model") then
		return template:Clone()
	end
	local model = Instance.new("Model")
	model.Name = "RareMerchant"
	local counter = Instance.new("Part")
	counter.Name = "Counter"
	counter.Anchored = true
	counter.Size = Vector3.new(6, 3, 3)
	counter.Color = Color3.fromRGB(122, 74, 36)
	counter.Material = Enum.Material.WoodPlanks
	counter.CFrame = CFrame.new(0, 1.5, 0)
	counter.Parent = model
	local prompt = Instance.new("ProximityPrompt")
	prompt.Parent = counter
	model.PrimaryPart = counter
	return model
end

-- Окно торговца: запоминаем, у какого торговца игрок (и его множитель цены)
local traderContext: { [Player]: { Mult: number, Pos: Vector3, Time: number } } = {}

local function openTrader(player: Player, mult: number, pos: Vector3)
	traderContext[player] = { Mult = mult, Pos = pos, Time = os.clock() }
	Remotes.Event("Effect"):FireClient(player, "OpenTrader", mult)
end

local activeMerchant: Model? = nil

local function spawnMerchant()
	if activeMerchant then
		return
	end
	local spots = {}
	for _, level in ipairs(MapService.Levels()) do
		if level.MerchantSpot then
			table.insert(spots, level)
		end
	end
	if #spots == 0 then
		return
	end
	local level = spots[rng:NextInteger(1, #spots)]
	local model = buildMerchantModel()
	model.Name = "RareMerchant"
	model:PivotTo((level.MerchantSpot :: BasePart).CFrame)
	local prompt = MapService.FindPrompt(model)
	if prompt then
		prompt.ActionText = ("Торговать (цены ×%s)"):format(tostring(Settings.RareMerchant.PriceMultiplier))
		prompt.ObjectText = "Редкий торговец"
		prompt.RequiresLineOfSight = false
		prompt.Triggered:Connect(function(player)
			openTrader(player, Settings.RareMerchant.PriceMultiplier, (level.MerchantSpot :: BasePart).Position)
		end)
	end
	model.Parent = Workspace
	activeMerchant = model
	RequestService.NotifyAll(("Редкий торговец появился на уровне %d! Покупает руды ×%s"):format(level.Id, tostring(Settings.RareMerchant.PriceMultiplier)), "event")
	task.delay(Settings.RareMerchant.Duration, function()
		if activeMerchant == model then
			activeMerchant = nil
		end
		model:Destroy()
	end)
end

function OreService.Init()
	-- Торговец в лобби
	task.spawn(function()
		local trader = MapService.Hub():WaitForChild("OreTrader", 10)
		local prompt = MapService.FindPrompt(trader)
		if prompt then
			prompt.ActionText = "Торговать"
			prompt.Triggered:Connect(function(player)
				local part = prompt.Parent
				openTrader(player, 1, part and part:IsA("BasePart") and part.Position or Vector3.zero)
			end)
		end
	end)

	RequestService.Register("SellOres", function(player, ids)
		local ctx = traderContext[player]
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not ctx or not root or (root.Position - ctx.Pos).Magnitude > 30 then
			return { ok = false, msg = "Подойди к торговцу" }
		end
		local list = nil
		if type(ids) == "table" then
			list = {}
			for _, id in ipairs(ids) do
				if type(id) == "string" and Catalog.Ores[id] then
					table.insert(list, id)
				end
			end
		end
		OreService.SellOres(player, list, ctx.Mult)
		return { ok = true }
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		traderContext[p] = nil
	end)

	-- Редкий торговец
	task.spawn(function()
		while true do
			task.wait(Settings.RareMerchant.CheckInterval)
			if rng:NextNumber() < Settings.RareMerchant.Chance then
				spawnMerchant()
			end
		end
	end)
end

return OreService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002282"><Properties>
<string name="Name">PetService</string>
<ProtectedString name="Source"><![CDATA[--[[
	PetService — яйца и питомцы.
	Яйцо открывается кнопкой у яйца в лобби (ProximityPrompt).
	Надетые питомцы записываются в атрибут игрока "EquippedPets" — клиент рисует их рядом с игроком.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("GameSettings"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared:WaitForChild("Catalog"))
local Format = require(Shared:WaitForChild("Format"))
local PetConfig = require(Config:WaitForChild("PetConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local MarketplaceService = game:GetService("MarketplaceService")
local Remotes = require(Shared:WaitForChild("Remotes"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local RequestService = require(Services:WaitForChild("RequestService"))
local MapService = require(Services:WaitForChild("MapService"))
local MonetizationService = require(Services:WaitForChild("MonetizationService"))

local PetService = {}
local rng = Random.new()

local function findPet(data, uid: number)
	for i, pet in ipairs(data.Pets) do
		if pet.Uid == uid then
			return pet, i
		end
	end
	return nil, nil
end

local function isEquipped(data, uid: number): boolean
	return table.find(data.EquippedPets, uid) ~= nil
end

function PetService.UpdateAttribute(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local ids = {}
	for _, uid in ipairs(data.EquippedPets) do
		local pet = findPet(data, uid)
		if pet then
			table.insert(ids, pet.Id)
		end
	end
	player:SetAttribute("EquippedPets", table.concat(ids, ","))
end

local function rollPet(egg): string
	local total = 0
	for _, entry in ipairs(egg.Pets) do
		total += entry[2]
	end
	local r = rng:NextNumber() * total
	for _, entry in ipairs(egg.Pets) do
		r -= entry[2]
		if r <= 0 then
			return entry[1]
		end
	end
	return egg.Pets[#egg.Pets][1]
end

-- Выдать питомца из яйца (после оплаты победами или Robux)
local function hatch(player: Player, data, egg)
	local petId = rollPet(egg)
	local uid = data.NextPetUid
	data.NextPetUid += 1
	table.insert(data.Pets, { Uid = uid, Id = petId })
	data.Stats.EggsOpened += 1
	if #data.EquippedPets < Settings.MaxEquippedPets then
		table.insert(data.EquippedPets, uid)
	end
	PetService.UpdateAttribute(player)
	DataService.MarkDirty(player)
	-- клиент показывает анимацию-рулетку, а после неё — сообщение
	Remotes.Event("Effect"):FireClient(player, "Egg", egg.Id, petId)
	return petId
end

-- Игрок должен стоять рядом с яйцом на карте
local function nearEgg(player: Player, eggId: string): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end
	for _, egg in ipairs(MapService.Eggs()) do
		if egg.Id == eggId then
			local pivot = egg.Model:GetPivot().Position
			return (Vector3.new(pivot.X, root.Position.Y, pivot.Z) - root.Position).Magnitude < 25
		end
	end
	return false
end

function PetService.OpenEgg(player: Player, eggId: string)
	local data = DataService.Get(player)
	local egg = type(eggId) == "string" and Catalog.Eggs[eggId]
	if not data or not egg then
		return { ok = false }
	end
	if not nearEgg(player, egg.Id) then
		return { ok = false, msg = "Подойди к яйцу" }
	end
	if #data.Pets >= Settings.MaxPetsInInventory then
		return { ok = false, msg = "Инвентарь питомцев полон — удалите лишних" }
	end
	if egg.RobuxProduct then
		local id = 0
		for _, p in ipairs(ShopConfig.Products) do
			if p.Key == egg.RobuxProduct then
				id = p.Id
			end
		end
		if id == 0 then
			return { ok = false, msg = "Покупка ещё не настроена (товар " .. egg.RobuxProduct .. " в ShopConfig)" }
		end
		MarketplaceService:PromptProductPurchase(player, id)
		return { ok = true, prompted = true }
	end
	if data.Wins < egg.Price then
		return { ok = false, msg = ("Нужно %s побед"):format(Format.Short(egg.Price)) }
	end
	data.Wins -= egg.Price
	return { ok = true, pet = hatch(player, data, egg) }
end

function PetService.Equip(player: Player, uid: number)
	local data = DataService.Get(player)
	if type(uid) ~= "number" or not findPet(data, uid) or isEquipped(data, uid) then
		return { ok = false }
	end
	if #data.EquippedPets >= Settings.MaxEquippedPets then
		return { ok = false, msg = ("Можно надеть не больше %d питомцев"):format(Settings.MaxEquippedPets) }
	end
	table.insert(data.EquippedPets, uid)
	PetService.UpdateAttribute(player)
	DataService.MarkDirty(player)
	return { ok = true }
end

function PetService.Unequip(player: Player, uid: number)
	local data = DataService.Get(player)
	local i = table.find(data.EquippedPets, uid)
	if i then
		table.remove(data.EquippedPets, i)
		PetService.UpdateAttribute(player)
		DataService.MarkDirty(player)
	end
	return { ok = true }
end

function PetService.EquipBest(player: Player)
	local data = DataService.Get(player)
	local sorted = table.clone(data.Pets)
	table.sort(sorted, function(a, b)
		local da, db = Catalog.Pets[a.Id], Catalog.Pets[b.Id]
		return (da and da.Multiplier or 0) > (db and db.Multiplier or 0)
	end)
	data.EquippedPets = {}
	for i = 1, math.min(Settings.MaxEquippedPets, #sorted) do
		table.insert(data.EquippedPets, sorted[i].Uid)
	end
	PetService.UpdateAttribute(player)
	DataService.MarkDirty(player)
	return { ok = true }
end

function PetService.Delete(player: Player, uid: number)
	local data = DataService.Get(player)
	local _, index = findPet(data, uid)
	if not index then
		return { ok = false }
	end
	PetService.Unequip(player, uid)
	table.remove(data.Pets, index)
	DataService.MarkDirty(player)
	return { ok = true }
end

function PetService.Init()
	RequestService.Register("OpenEgg", PetService.OpenEgg)
	RequestService.Register("EquipPet", PetService.Equip)
	RequestService.Register("UnequipPet", PetService.Unequip)
	RequestService.Register("EquipBestPets", PetService.EquipBest)
	RequestService.Register("DeletePet", PetService.Delete)

	DataService.OnLoaded(function(player)
		PetService.UpdateAttribute(player)
	end)

	-- Яйца за Robux: после оплаты сразу открываем
	for _, egg in ipairs(PetConfig.Eggs) do
		if egg.RobuxProduct then
			MonetizationService.RegisterProductHandler(egg.RobuxProduct, function(player, data)
				hatch(player, data, egg)
				return true
			end)
		end
	end

	-- Подписи на карточках яиц
	task.spawn(function()
		for _, egg in ipairs(MapService.Eggs()) do
			local cfg = Catalog.Eggs[egg.Id]
			if cfg then
				MapService.SetText(egg.Model, "Title", cfg.Name)
				MapService.SetText(egg.Model, "Tag", cfg.Tag or "")
				MapService.SetText(egg.Model, "Price", cfg.RobuxProduct and (tostring(cfg.RobuxPrice) .. " Robux") or (Format.Short(cfg.Price) .. " Побед"))
			end
		end
	end)
end

return PetService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002283"><Properties>
<string name="Name">PickaxeService</string>
<ProtectedString name="Source"><![CDATA[--[[
	PickaxeService — магазин кирок, удача, выдача кирки в руки.

	Своя 3D-модель кирки: положите Tool в ServerStorage › PickaxeModels
	и назовите его как Id кирки (например "gold"). Внутри должна быть деталь "Handle".
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PickaxeConfig = require(Config:WaitForChild("PickaxeConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared:WaitForChild("Catalog"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local Format = require(Shared:WaitForChild("Format"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local RequestService = require(Services:WaitForChild("RequestService"))
local MapService = require(Services:WaitForChild("MapService"))

local PickaxeService = {}
local TOOL_NAME = "Pickaxe"

local function buildTool(cfg): Tool
	local custom = ServerStorage:FindFirstChild("PickaxeModels")
	local model = custom and custom:FindFirstChild(cfg.Id)
	if model and model:IsA("Tool") then
		local tool = model:Clone()
		tool.Name = TOOL_NAME
		return tool
	end

	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.ToolTip = cfg.Name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	-- Хват как у классического меча: рукоять вдоль Z, держим за нижний конец
	tool.GripPos = Vector3.new(0, 0, -1.6)
	tool.GripForward = Vector3.new(-1, 0, 0)
	tool.GripRight = Vector3.new(0, 1, 0)
	tool.GripUp = Vector3.new(0, 0, 1)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.45, 0.45, 4.4)
	handle.Color = cfg.HandleColor
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.CFrame = CFrame.new()
	handle.Parent = tool

	local function addPart(name: string, size: Vector3, offset: CFrame, material: Enum.Material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = cfg.Color
		p.Material = material
		p.CanCollide = false
		p.Massless = true
		p.CFrame = handle.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = p
		weld.Parent = p
		p.Parent = tool
	end
	-- Головка кирки: перекладина и два острых конца
	addPart("Head", Vector3.new(3.4, 0.55, 0.6), CFrame.new(0, 0, 2.1), Enum.Material.Metal)
	addPart("TipA", Vector3.new(0.9, 0.4, 0.45), CFrame.new(-1.9, -0.2, 2.1) * CFrame.Angles(0, 0, math.rad(-25)), Enum.Material.Metal)
	addPart("TipB", Vector3.new(0.9, 0.4, 0.45), CFrame.new(1.9, -0.2, 2.1) * CFrame.Angles(0, 0, math.rad(25)), Enum.Material.Metal)
	addPart("Cap", Vector3.new(0.8, 0.8, 0.8), CFrame.new(0, 0, 2.1), Enum.Material.Neon)
	return tool
end

-- Выдать (или заменить) кирку и сразу взять её в руки
function PickaxeService.GiveTool(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local cfg = Catalog.Pickaxe(data.EquippedPickaxe)
	for _, container in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item.Name == TOOL_NAME then
					item:Destroy()
				end
			end
		end
	end
	local tool = buildTool(cfg)
	local backpack = player:WaitForChild("Backpack", 5)
	if not backpack then
		return
	end
	tool.Parent = backpack
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:EquipTool(tool)
	end
end

function PickaxeService.Buy(player: Player, id: string)
	local data = DataService.Get(player)
	local cfg = type(id) == "string" and Catalog.Pickaxes[id]
	if not cfg then
		return { ok = false }
	end
	if data.OwnedPickaxes[id] then
		return PickaxeService.Equip(player, id)
	end
	if data.Wins < cfg.Price then
		return { ok = false, msg = ("Нужно %s побед"):format(Format.Short(cfg.Price)) }
	end
	data.Wins -= cfg.Price
	data.OwnedPickaxes[id] = true
	data.EquippedPickaxe = id
	DataService.MarkDirty(player)
	PickaxeService.GiveTool(player)
	RequestService.Notify(player, "Куплена кирка: " .. cfg.Name, "success")
	return { ok = true }
end

function PickaxeService.Equip(player: Player, id: string)
	local data = DataService.Get(player)
	if type(id) ~= "string" or not data.OwnedPickaxes[id] or not Catalog.Pickaxes[id] then
		return { ok = false, msg = "Сначала купите эту кирку" }
	end
	data.EquippedPickaxe = id
	DataService.MarkDirty(player)
	PickaxeService.GiveTool(player)
	return { ok = true }
end

function PickaxeService.BuyLuck(player: Player, offerId: string)
	local data = DataService.Get(player)
	local offer = nil
	for _, o in ipairs(ShopConfig.Luck.Offers) do
		if o.Id == offerId then
			offer = o
		end
	end
	if not offer then
		return { ok = false }
	end
	if data.LuckPercent >= ShopConfig.Luck.MaxPercent then
		return { ok = false, msg = "Удача уже максимальная" }
	end
	local bought = data.LuckBought[offer.Id] or 0
	local cost = Formulas.LuckOfferCost(offer, bought)
	if data.Wins < cost then
		return { ok = false, msg = ("Нужно %s побед"):format(Format.Short(cost)) }
	end
	data.Wins -= cost
	data.LuckBought[offer.Id] = bought + 1
	data.LuckPercent = math.min(ShopConfig.Luck.MaxPercent, data.LuckPercent + offer.Percent)
	DataService.MarkDirty(player)
	RequestService.Notify(player, ("%s: +%d%% удачи!"):format(offer.Name, offer.Percent), "success")
	return { ok = true }
end

local function setupSlots()
	for _, slot in ipairs(MapService.PickaxeSlots()) do
		local cfg = PickaxeConfig.Pickaxes[slot.Index]
		local prompt = MapService.FindPrompt(slot.BuyPad)
		if cfg then
			local priceText = cfg.Price == 0 and "Бесплатно" or Format.Short(cfg.Price)
			MapService.SetText(slot.BuyPad, "Price", priceText)
			MapService.SetText(slot.Model, "PickName", cfg.Name)
			MapService.SetText(slot.Model, "PickInfo", ("%s · x%s Силы"):format(cfg.Rarity or "", Format.Short(cfg.Power)))
			if prompt then
				prompt.ObjectText = ("%s · сила ×%s"):format(cfg.Name, Format.Short(cfg.Power))
				prompt.ActionText = cfg.Price == 0 and "Взять" or ("Купить за " .. priceText)
				prompt.Triggered:Connect(function(player)
					local res = PickaxeService.Buy(player, cfg.Id)
					if res and res.msg then
						RequestService.Notify(player, res.msg, "error")
					end
				end)
			end
		else
			-- Место без кирки в конфиге
			MapService.SetText(slot.BuyPad, "Price", "—")
			if prompt then
				prompt.Enabled = false
			end
		end
	end
end

function PickaxeService.Init()
	RequestService.Register("BuyPickaxe", PickaxeService.Buy)
	RequestService.Register("EquipPickaxe", PickaxeService.Equip)
	RequestService.Register("BuyLuck", PickaxeService.BuyLuck)

	local function onCharacter(player: Player)
		task.wait(0.3)
		if DataService.Get(player) then
			PickaxeService.GiveTool(player)
		end
	end
	DataService.OnLoaded(function(player)
		player.CharacterAdded:Connect(function()
			onCharacter(player)
		end)
		if player.Character then
			onCharacter(player)
		end
	end)

	task.spawn(setupSlots)
end

return PickaxeService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002284"><Properties>
<string name="Name">RebirthService</string>
<ProtectedString name="Source"><![CDATA[--[[
	RebirthService — перерождение (настройки в RebirthConfig).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("GameSettings"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared:WaitForChild("Formulas"))
local Format = require(Shared:WaitForChild("Format"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local RequestService = require(Services:WaitForChild("RequestService"))
local PickaxeService = require(Services:WaitForChild("PickaxeService"))
local WallService = require(Services:WaitForChild("WallService"))
local MapService = require(Services:WaitForChild("MapService"))

local RebirthService = {}

function RebirthService.Init()
	RequestService.Register("Rebirth", function(player)
		local data = DataService.Get(player)
		local needLevel = Formulas.RebirthLevel(data.Rebirths)
		if data.PlayerLevel < needLevel then
			return { ok = false, msg = ("Нужен уровень %d (сейчас %d). Качайся в ямах!"):format(needLevel, data.PlayerLevel) }
		end
		local cost = Formulas.RebirthCost(data.Rebirths)
		if data.Wins < cost then
			return { ok = false, msg = ("Нужно %s побед"):format(Format.Short(cost)) }
		end
		data.Wins -= cost
		data.Rebirths += 1
		data.PlayerLevel = 1
		data.Xp = 0
		data.Stats.Rebirths += 1
		data.Strength = 0
		data.OwnedPickaxes = { [Settings.StartPickaxe] = true }
		data.EquippedPickaxe = Settings.StartPickaxe
		data.LevelProgress = {}
		WallService.ResetPlayer(player)
		DataService.MarkDirty(player)
		PickaxeService.GiveTool(player)
		local character = player.Character
		if character then
			character:PivotTo(MapService.SpawnCFrame()) -- после перерождения — на спавн
		end
		RequestService.Notify(player, ("Перерождение %d! Сила навсегда ×%s"):format(data.Rebirths, tostring(Formulas.RebirthMultiplier(data))), "success")
		return { ok = true }
	end)

	DataService.AddStateHook(function(_, state, data)
		state.RebirthCost = Formulas.RebirthCost(data.Rebirths)
		state.RebirthLevel = Formulas.RebirthLevel(data.Rebirths)
	end)
end

return RebirthService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002285"><Properties>
<string name="Name">RequestService</string>
<ProtectedString name="Source"><![CDATA[--[[
	RequestService — единая точка для действий игрока из интерфейса (покупки, надеть и т.д.).
	Каждый сервис регистрирует свои действия через RequestService.Register("Имя", функция).
	Здесь же — защита от спама и уведомления.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local RequestService = {}
local handlers = {}
local callLog: { [Player]: { number } } = {}

function RequestService.Register(name: string, fn)
	handlers[name] = fn
end

function RequestService.Notify(player: Player, text: string, kind: string?)
	Remotes.Event("Notify"):FireClient(player, text, kind or "info")
end

function RequestService.NotifyAll(text: string, kind: string?)
	Remotes.Event("Notify"):FireAllClients(text, kind or "info")
end

local function rateLimited(player: Player): boolean
	local now = os.clock()
	local log = callLog[player] or {}
	callLog[player] = log
	while #log > 0 and now - log[1] > 1 do
		table.remove(log, 1)
	end
	if #log >= 12 then
		return true
	end
	table.insert(log, now)
	return false
end

function RequestService.Init()
	Remotes.Function("Request").OnServerInvoke = function(player: Player, action: any, ...)
		if type(action) ~= "string" or not handlers[action] then
			return { ok = false }
		end
		if rateLimited(player) then
			return { ok = false, msg = "Слишком быстро!" }
		end
		if not DataService.Get(player) then
			return { ok = false, msg = "Данные ещё загружаются…" }
		end
		local ok, result = pcall(handlers[action], player, ...)
		if not ok then
			warn("[Request]", action, result)
			return { ok = false, msg = "Ошибка, попробуйте ещё раз" }
		end
		return result or { ok = true }
	end

	-- Настройки игрока (автоклик, показ питомцев)
	RequestService.Register("SetSetting", function(player, key, value)
		local data = DataService.Get(player)
		if (key == "AutoClick" or key == "ShowPets") and type(value) == "boolean" then
			data.Settings[key] = value
			DataService.MarkDirty(player)
			return { ok = true }
		end
		return { ok = false }
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		callLog[player] = nil
	end)
end

return RequestService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002286"><Properties>
<string name="Name">SwingService</string>
<ProtectedString name="Source"><![CDATA[--[[
	SwingService — обработка ударов киркой.
	Клиент только сообщает «я ударил». Сервер сам проверяет паузу между ударами,
	что кирка в руках и где стоит игрок (в яме или перед стеной).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("GameSettings"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local TrainingService = require(Services:WaitForChild("TrainingService"))
local WallService = require(Services:WaitForChild("WallService"))

local SwingService = {}
local lastSwing: { [Player]: number } = {}

local function playSlash(tool: Tool)
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim" -- стандартный скрипт Animate проигрывает удар
	anim.Value = "Slash"
	anim.Parent = tool
	game:GetService("Debris"):AddItem(anim, 1)
end

function SwingService.Init()
	Remotes.Event("Swing").OnServerEvent:Connect(function(player: Player)
		local now = os.clock()
		if lastSwing[player] and now - lastSwing[player] < Settings.SwingCooldown * 0.8 then
			return
		end
		lastSwing[player] = now

		local data = DataService.Get(player)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local tool = character and character:FindFirstChild("Pickaxe")
		if not data or not root or not tool or not tool:IsA("Tool") then
			return
		end
		playSlash(tool)
		local pos = root.Position
		if TrainingService.TrySwing(player, data, pos) then
			return
		end
		if WallService.TrySwing(player, data, pos) then
			return
		end
		TrainingService.AirSwing(player, data)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
	end)
end

return SwingService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002287"><Properties>
<string name="Name">TrainingService</string>
<ProtectedString name="Source"><![CDATA[--[[
	TrainingService — ямы прокачки силы и удары по воздуху.
	• Игрок спрыгивает в яму (внутрь детали TrainZone): кирка бьёт сама (GameSettings.PitAutoInterval),
	  а каждый клик добавляет ещё удар. В яме сила за удар минимум в 2 раза больше, чем по воздуху.
	• Удар по воздуху (не в яме и не по стене) даёт GameSettings.AirSwingPower силы (минимум 1).
	• Закрытые ямы накрыты барьером LockBarrier (клиент убирает его, когда яма открыта).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PitConfig = require(Config:WaitForChild("PitConfig"))
local Settings = require(Config:WaitForChild("GameSettings"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared:WaitForChild("Formulas"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local RequestService = require(Services:WaitForChild("RequestService"))
local MapService = require(Services:WaitForChild("MapService"))
local MonetizationService = require(Services:WaitForChild("MonetizationService"))
local BoostService = require(Services:WaitForChild("BoostService"))

local TrainingService = {}
local pits = {}
local lastLockNotice: { [Player]: number } = {}

local function pitAt(pos: Vector3)
	for _, pit in ipairs(pits) do
		if pit.Zone and MapService.PointInPart(pit.Zone, pos) then
			return pit
		end
	end
	return nil
end

local function gainStrength(player: Player, data, power: number)
	local gain = Formulas.StrengthPerSwing(data, power, MonetizationService.HasPass(player, "StrengthX2")) * BoostService.Multiplier(player)
	data.Strength += gain
	DataService.MarkDirty(player)
	Remotes.Event("Effect"):FireClient(player, "Strength", gain)
end

local function playSlash(player: Player)
	local character = player.Character
	local tool = character and character:FindFirstChild("Pickaxe")
	if tool and tool:IsA("Tool") then
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		game:GetService("Debris"):AddItem(anim, 1)
	end
end

-- Добавить опыт и поднять уровень (используется ямами и пакетами опыта)
function TrainingService.AddXp(player: Player, data, amount: number)
	data.Xp += math.max(1, math.floor(amount))
	local leveled = false
	while data.Xp >= Formulas.XpForLevel(data.PlayerLevel) do
		data.Xp -= Formulas.XpForLevel(data.PlayerLevel)
		data.PlayerLevel += 1
		leveled = true
	end
	if leveled then
		Remotes.Event("Effect"):FireClient(player, "LevelUp", data.PlayerLevel)
	end
	DataService.MarkDirty(player)
end

local function gainXp(player: Player, data, pitPower: number)
	TrainingService.AddXp(player, data, pitPower * Settings.Xp.PerPitPower * BoostService.Multiplier(player))
end

-- Удар в яме. true — игрок стоит в яме (даже если она закрыта)
function TrainingService.TrySwing(player: Player, data, pos: Vector3): boolean
	local pit = pitAt(pos)
	if not pit then
		return false
	end
	local cfg = PitConfig.Pits[pit.Index]
	if not cfg then
		return true
	end
	if data.Rebirths < cfg.RequiredRebirths then
		local now = os.clock()
		if not lastLockNotice[player] or now - lastLockNotice[player] > 3 then
			lastLockNotice[player] = now
			RequestService.Notify(player, ("Яма «%s» откроется после %d перерождений"):format(cfg.Name, cfg.RequiredRebirths), "error")
		end
		return true
	end
	gainStrength(player, data, cfg.Power)
	gainXp(player, data, cfg.Power)
	data.Stats.Swings += 1
	return true
end

-- Удар по воздуху (не в яме и не по стене)
function TrainingService.AirSwing(player: Player, data)
	gainStrength(player, data, Settings.AirSwingPower)
end

function TrainingService.Init()
	pits = MapService.Pits()
	for _, pit in ipairs(pits) do
		local cfg = PitConfig.Pits[pit.Index]
		if cfg then
			MapService.SetText(pit.Sign, "Title", cfg.Name)
			MapService.SetText(pit.Sign, "Sub", ("Перерождения: %d"):format(cfg.RequiredRebirths))
		else
			MapService.SetText(pit.Sign, "Title", "Новая яма")
			MapService.SetText(pit.Sign, "Sub", "свободное место")
		end
	end

	-- Пакеты опыта за Robux (кнопки под полосой уровня)
	for _, key in ipairs({ "xp_small", "xp_medium", "xp_big" }) do
		MonetizationService.RegisterProductHandler(key, function(player, data, product)
			local amount = Formulas.XpForLevel(data.PlayerLevel) * (product.XpFactor or 1)
			TrainingService.AddXp(player, data, amount)
			RequestService.Notify(player, "+" .. tostring(math.floor(amount)) .. " опыта!", "success")
			return true
		end)
	end

	-- Автоудары в открытой яме
	task.spawn(function()
		while true do
			task.wait(Settings.PitAutoInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.Get(player)
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local pit = root and pitAt(root.Position)
				local cfg = pit and PitConfig.Pits[pit.Index]
				if data and cfg and data.Rebirths >= cfg.RequiredRebirths then
					playSlash(player)
					gainStrength(player, data, cfg.Power)
					gainXp(player, data, cfg.Power)
					data.Stats.Swings += 1
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(p)
		lastLockNotice[p] = nil
	end)
end

return TrainingService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002288"><Properties>
<string name="Name">WallService</string>
<ProtectedString name="Source"><![CDATA[--[[
	WallService — уровни: 10 слоёв стены, автоудары, выбор награды.

	• Стены у каждого игрока свои: сервер хранит прогресс (сколько слоёв сломано),
	  клиент скрывает сломанные слои только у себя.
	• Пока игрок стоит в уровне перед стеной, стена бьётся сама (GameSettings.AutoBreakInterval).
	  Если тапать — быстрее. Если силы хватает, слой ломается с одного удара.
	• После стены — промежуток с нишей справа. В нише 2 площадки:
	    RewardPad — «+N побед и в лобби» (бесплатно),
	    X3Pad     — «×3 и в лобби» (Robux, товар level_x3 в ShopConfig).
	  Или иди дальше — на следующем уровне награда больше.
	  N = награда самого дальнего пройденного уровня (LevelConfig.WinsReward).
	  После получения награды все стены снова целые — награда выдаётся один раз за забег.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Config = ReplicatedStorage:WaitForChild("Config")
local LevelConfig = require(Config:WaitForChild("LevelConfig"))
local Settings = require(Config:WaitForChild("GameSettings"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared:WaitForChild("Formulas"))
local Format = require(Shared:WaitForChild("Format"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local RequestService = require(Services:WaitForChild("RequestService"))
local MapService = require(Services:WaitForChild("MapService"))
local MonetizationService = require(Services:WaitForChild("MonetizationService"))
local OreService = require(Services:WaitForChild("OreService"))
local BoostService = require(Services:WaitForChild("BoostService"))

local WallService = {}
local LAYERS = LevelConfig.LayersPerLevel

local hp: { [Player]: { [number]: number } } = {} -- оставшаяся прочность текущего слоя
local currentLevel: { [Player]: number? } = {}

local function progressOf(data, levelId: number): number
	return data.LevelProgress[tostring(levelId)] or 0
end

-- Самый дальний уровень, стена которого сломана в этом забеге
function WallService.RunBest(data): number
	local best = 0
	for key, prog in pairs(data.LevelProgress) do
		local id = tonumber(key)
		if id and prog >= LAYERS and id > best then
			best = id
		end
	end
	return best
end

function WallService.RewardFor(levelId: number): number
	local cfg = Catalog.Level(levelId)
	return cfg and cfg.WinsReward or 0
end

local function layerHP(player: Player, data, levelId: number): number
	hp[player] = hp[player] or {}
	local prog = progressOf(data, levelId)
	if hp[player][levelId] == nil then
		hp[player][levelId] = Formulas.LayerHP(levelId, math.min(prog + 1, LAYERS))
	end
	return hp[player][levelId]
end

function WallService.ResetPlayer(player: Player)
	hp[player] = {}
end

local function sendLevelState(player: Player, levelId: number?)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local cfg = levelId and Catalog.Level(levelId)
	if not levelId or not cfg then
		Remotes.Event("LevelState"):FireClient(player, nil)
		return
	end
	local prog = progressOf(data, levelId)
	local best = WallService.RunBest(data)
	Remotes.Event("LevelState"):FireClient(player, {
		Level = levelId,
		Name = cfg.Name,
		Layer = prog,
		Layers = LAYERS,
		HP = prog >= LAYERS and 0 or layerHP(player, data, levelId),
		MaxHP = Formulas.LayerHP(levelId, math.min(prog + 1, LAYERS)),
		Recommended = Formulas.RecommendedStrength(levelId),
		RunBest = best,
		RunReward = WallService.RewardFor(best),
	})
end

local function playSlash(player: Player)
	local character = player.Character
	local tool = character and character:FindFirstChild("Pickaxe")
	if tool and tool:IsA("Tool") then
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		game:GetService("Debris"):AddItem(anim, 1)
	end
end

-- Текущий слой, если игрок стоит перед ним
local function targetLayer(data, pos: Vector3)
	local level = MapService.LevelAt(pos)
	if not level or not Catalog.Level(level.Id) then
		return nil, nil
	end
	local prog = progressOf(data, level.Id)
	if prog >= LAYERS then
		return level, nil
	end
	local layer = level.Layers[prog + 1] :: BasePart?
	if not layer then
		return level, nil
	end
	local rel = layer.CFrame:PointToObjectSpace(pos)
	if math.abs(rel.Z) > layer.Size.Z / 2 + Settings.WallReach or math.abs(rel.X) > layer.Size.X / 2 + 4 then
		return level, nil
	end
	return level, layer
end

local function hit(player: Player, data, level)
	local remaining = layerHP(player, data, level.Id) - Formulas.Damage(data) * BoostService.Multiplier(player)
	if remaining > 0 then
		hp[player][level.Id] = remaining
		sendLevelState(player, level.Id)
		return
	end
	-- Слой сломан
	local prog = progressOf(data, level.Id) + 1
	data.LevelProgress[tostring(level.Id)] = prog
	data.Stats.LayersBroken += 1
	hp[player][level.Id] = nil
	Remotes.Event("Effect"):FireClient(player, "Break", level.Id, prog)
	OreService.Roll(player, data)
	if prog >= LAYERS then
		data.BestLevel = math.max(data.BestLevel, level.Id)
	end
	DataService.MarkDirty(player)
	sendLevelState(player, level.Id)
end

-- Удар из SwingService. true — удар пришёлся по стене.
function WallService.TrySwing(player: Player, data, pos: Vector3): boolean
	local level, layer = targetLayer(data, pos)
	if not level or not layer then
		return false
	end
	hit(player, data, level)
	return true
end

local function teleportToLobby(player: Player)
	local character = player.Character
	if character then
		character:PivotTo(MapService.SpawnCFrame())
	end
end

-- Забрать награду за забег и вернуться в лобби
function WallService.CashOut(player: Player, multiplier: number, levelOverride: number?): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local best = levelOverride or WallService.RunBest(data)
	if best <= 0 then
		return 0
	end
	local wins = WallService.RewardFor(best) * multiplier
	data.Wins += wins
	data.Stats.LevelsCleared += best
	data.LevelProgress = {}
	data.PendingX3Level = 0
	hp[player] = {}
	DataService.MarkDirty(player)
	teleportToLobby(player)
	Remotes.Event("Effect"):FireClient(player, "Reward", best, wins)
	RequestService.Notify(player, ("+%s побед!"):format(Format.Short(wins)), "wins")
	task.delay(0.5, sendLevelState, player, nil)
	return wins
end

local function productId(key: string): number
	for _, p in ipairs(ShopConfig.Products) do
		if p.Key == key then
			return p.Id
		end
	end
	return 0
end

function WallService.Init()
	for _, level in ipairs(MapService.Levels()) do
		local cfg = Catalog.Level(level.Id)
		if cfg then
			MapService.SetText(level.Sign, "Title", ("Уровень %d · %s"):format(level.Id, cfg.Name))
			MapService.SetText(level.Sign, "Sub", ("Сила: %s · награда %s побед"):format(Format.Short(Formulas.RecommendedStrength(level.Id)), Format.Short(cfg.WinsReward)))
		end
	end

	-- Площадки в нише
	local padDebounce: { [Player]: number } = {}
	local function playerFromHit(hit: BasePart): Player?
		local model = hit:FindFirstAncestorOfClass("Model")
		return model and Players:GetPlayerFromCharacter(model)
	end
	local function canUse(player: Player, cooldown: number): boolean
		local now = os.clock()
		if padDebounce[player] and now - padDebounce[player] < cooldown then
			return false
		end
		padDebounce[player] = now
		return true
	end
	Players.PlayerRemoving:Connect(function(p)
		padDebounce[p] = nil
	end)
	for _, level in ipairs(MapService.Levels()) do
		local cfg = Catalog.Level(level.Id)
		local reward = cfg and cfg.WinsReward or 0
		if level.RewardPad then
			MapService.SetText(level.RewardPad, "Reward", ("+%s %s"):format(Format.Short(reward), reward == 1 and "победа" or "побед"))
			level.RewardPad.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				local data = player and DataService.Get(player)
				if not player or not data or not canUse(player, 1.5) then
					return
				end
				if WallService.RunBest(data) <= 0 then
					RequestService.Notify(player, "Сначала сломай стену уровня", "error")
					return
				end
				WallService.CashOut(player, MonetizationService.HasPass(player, "WinsX3") and 3 or 1)
			end)
		end
		if level.X3Pad then
			MapService.SetText(level.X3Pad, "Reward", ("x3 = %s побед"):format(Format.Short(reward * 3)))
			level.X3Pad.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				local data = player and DataService.Get(player)
				if not player or not data or not canUse(player, 4) then
					return
				end
				local best = WallService.RunBest(data)
				if best <= 0 then
					RequestService.Notify(player, "Сначала сломай стену уровня", "error")
					return
				end
				if MonetizationService.HasPass(player, "WinsX3") then
					WallService.CashOut(player, 3)
					return
				end
				local id = productId("level_x3")
				if id == 0 then
					RequestService.Notify(player, "Покупка ещё не настроена (товар level_x3 в ShopConfig)", "error")
					return
				end
				data.PendingX3Level = best
				MarketplaceService:PromptProductPurchase(player, id)
			end)
		end
	end

	RequestService.Register("CashOutLevel", function(player)
		local data = DataService.Get(player)
		if WallService.RunBest(data) <= 0 then
			return { ok = false, msg = "Сначала сломай стену уровня" }
		end
		WallService.CashOut(player, MonetizationService.HasPass(player, "WinsX3") and 3 or 1)
		return { ok = true }
	end)

	RequestService.Register("LevelRewardX3", function(player)
		local data = DataService.Get(player)
		local best = WallService.RunBest(data)
		if best <= 0 then
			return { ok = false, msg = "Сначала сломай стену уровня" }
		end
		local id = productId("level_x3")
		if id == 0 then
			return { ok = false, msg = "Покупка ещё не настроена (товар level_x3 в ShopConfig)" }
		end
		data.PendingX3Level = best
		MarketplaceService:PromptProductPurchase(player, id)
		return { ok = true }
	end)

	-- Оплата ×3: выдаём тройную награду за уровень, запомненный при нажатии кнопки
	MonetizationService.RegisterProductHandler("level_x3", function(player, data)
		local level = data.PendingX3Level
		if not level or level <= 0 then
			level = math.max(1, WallService.RunBest(data))
		end
		WallService.CashOut(player, 3, level)
		return true
	end)

	RequestService.Register("GoToLobby", function(player)
		teleportToLobby(player)
		return { ok = true }
	end)

	-- Следим, где стоит игрок: панель уровня + автоудары по стене
	task.spawn(function()
		local acc = 0
		while true do
			task.wait(0.2)
			acc += 0.2
			local autoHit = acc >= Settings.AutoBreakInterval
			if autoHit then
				acc = 0
			end
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.Get(player)
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if data and root then
					local level, layer = targetLayer(data, root.Position)
					local id = level and level.Id or nil
					if id ~= currentLevel[player] then
						currentLevel[player] = id
						sendLevelState(player, id)
					end
					if autoHit and level and layer then
						playSlash(player)
						hit(player, data, level)
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		hp[player] = nil
		currentLevel[player] = nil
	end)
end

return WallService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002289"><Properties>
<string name="Name">WheelService</string>
<ProtectedString name="Source"><![CDATA[--[[
	WheelService — колесо фортуны (настройки в WheelConfig).
	Бесплатное вращение раз в Cooldown секунд + купленные вращения (ShopConfig.Products).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local WheelConfig = require(Config:WaitForChild("WheelConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))

local Services = script.Parent
local DataService = require(Services:WaitForChild("DataService"))
local RequestService = require(Services:WaitForChild("RequestService"))
local AuraService = require(Services:WaitForChild("AuraService"))

local WheelService = {}
local rng = Random.new()

local function pickIndex(): number
	local total = 0
	for _, prize in ipairs(WheelConfig.Prizes) do
		total += prize.Weight
	end
	local r = rng:NextNumber() * total
	for i, prize in ipairs(WheelConfig.Prizes) do
		r -= prize.Weight
		if r <= 0 then
			return i
		end
	end
	return #WheelConfig.Prizes
end

local function applyPrize(player: Player, data, prize): string
	if prize.Type == "Wins" then
		data.Wins += prize.Amount
		return prize.Text
	elseif prize.Type == "StrengthPercent" then
		local gain = math.max(math.floor(data.Strength * prize.Amount / 100), prize.Amount)
		data.Strength += gain
		return "+" .. Format.Short(gain) .. " силы"
	elseif prize.Type == "Luck" then
		data.LuckPercent = math.min(ShopConfig.Luck.MaxPercent, data.LuckPercent + prize.Amount)
		return prize.Text
	elseif prize.Type == "Aura" then
		if AuraService.Grant(player, prize.AuraId) then
			return prize.Text
		end
		data.Wins += 25
		return "Аура уже есть → +25 побед"
	end
	return prize.Text
end

function WheelService.Init()
	RequestService.Register("SpinWheel", function(player)
		local data = DataService.Get(player)
		local now = os.time()
		local remaining = WheelConfig.Cooldown - (now - data.Wheel.LastFree)
		if remaining > 0 then
			if data.Wheel.ExtraSpins > 0 then
				data.Wheel.ExtraSpins -= 1
			else
				return { ok = false, msg = "Бесплатное вращение через " .. Format.Time(remaining) }
			end
		else
			data.Wheel.LastFree = now
		end
		local index = pickIndex()
		local text = applyPrize(player, data, WheelConfig.Prizes[index])
		DataService.MarkDirty(player)
		return { ok = true, index = index, text = text }
	end)

	DataService.AddStateHook(function(_, state, data)
		state.WheelReadyIn = math.max(0, WheelConfig.Cooldown - (os.time() - data.Wheel.LastFree))
	end)
end

return WheelService
]]></ProtectedString>
</Properties>
</Item>
