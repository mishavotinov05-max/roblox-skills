--[[
	GameSettings — общие настройки игры.
	Меняйте числа прямо здесь, в Roblox Studio (двойной клик по модулю в Explorer).
]]

return {
	-- Сохранение
	DataStoreName = "WallBreaker_Data_v1", -- если поменять имя, у всех игроков начнётся новый прогресс
	AutoSaveInterval = 60, -- секунды между автосохранениями

	-- Удары киркой
	SwingCooldown = 0.3, -- минимальная пауза между ударами (секунды)
	WallReach = 12, -- с какого расстояния (в стадах) можно ударить стену
	AutoClickInterval = 0.35, -- скорость автоклика (геймпасс)
	AirSwingPower = 0.3, -- сила за удар по воздуху (в ямах — от 1 и больше), до множителей
	AutoBreakInterval = 0.6, -- в уровне стена бьётся сама раз в столько секунд (тапать — быстрее)

	-- Питомцы
	MaxEquippedPets = 3, -- сколько питомцев можно надеть одновременно
	MaxPetsInInventory = 60, -- размер инвентаря питомцев

	-- Редкий торговец на уровнях
	RareMerchant = {
		CheckInterval = 90, -- раз в сколько секунд пробуем его вызвать
		Chance = 0.35, -- шанс появления при каждой проверке (0.35 = 35%)
		Duration = 120, -- сколько секунд он стоит
		PriceMultiplier = 2, -- во сколько раз дороже покупает руды, чем обычный торговец
	},

	-- Стартовые значения нового игрока
	StartWins = 0,
	StartStrength = 0,
	StartPickaxe = "wood", -- Id кирки из PickaxeConfig

	-- Отладка: в Studio каждый новый игрок получает это количество побед (0 = выключено)
	StudioTestWins = 0,
}
