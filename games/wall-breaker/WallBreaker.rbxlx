<Item class="ModuleScript" referent="RBX002252"><Properties>
<string name="Name">AuraConfig</string>
<ProtectedString name="Source"><![CDATA[--[[
	AuraConfig — ауры (свечение вокруг игрока).
	Price      — цена в победах (0 = купить нельзя, только из колеса фортуны).
	Multiplier — множитель силы, пока аура надета (надета может быть одна).
]]

return {
	Auras = {
		{ Id = "spark", Name = "Искра", Price = 30, Multiplier = 1.2, Color = Color3.fromRGB(255, 225, 77) },
		{ Id = "frost", Name = "Иней", Price = 150, Multiplier = 1.5, Color = Color3.fromRGB(94, 231, 255) },
		{ Id = "flame", Name = "Пламя", Price = 600, Multiplier = 2, Color = Color3.fromRGB(255, 106, 42) },
		{ Id = "void", Name = "Бездна", Price = 2500, Multiplier = 3, Color = Color3.fromRGB(166, 91, 255) },
		{ Id = "rainbow", Name = "Радуга", Price = 0, Multiplier = 4, Color = Color3.fromRGB(255, 95, 210) }, -- только из колеса
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002253"><Properties>
<string name="Name">GameSettings</string>
<ProtectedString name="Source"><![CDATA[--[[
	GameSettings — общие настройки игры.
	Меняйте числа прямо здесь, в Roblox Studio (двойной клик по модулю в Explorer).
]]

return {
	-- Сохранение
	DataStoreName = "WallBreaker_Data_v1", -- если поменять имя, у всех игроков начнётся новый прогресс
	AutoSaveInterval = 60, -- секунды между автосохранениями

	-- Удары киркой
	SwingCooldown = 0.3, -- минимальная пауза между ударами (секунды)
	WallReach = 12, -- с какого расстояния (в стадах) можно ударить стену
	AutoClickInterval = 0.35, -- скорость автоклика (геймпасс)
	AirSwingPower = 1, -- сила за удар по воздуху, до множителей (в ямах — Power из PitConfig, минимум ×2)
	StrengthMultiplier = 10, -- общий ускоритель силы: вся сила за удар × это число
	PitAutoInterval = 0.25, -- в открытой яме кирка бьёт сама раз в столько секунд (клики добавляют ещё)
	AutoBreakInterval = 0.6, -- в уровне стена бьётся сама раз в столько секунд (тапать — быстрее)

	-- Уровень игрока: опыт качается в ямах вместе с силой
	Xp = {
		PerPitPower = 3, -- опыт за удар в яме = Power ямы × это число
		Base = 10, -- опыт для перехода на уровень 2
		Growth = 1.3, -- каждый следующий уровень требует больше: Base × уровень^Growth
	},

	-- ТЕСТ: бесконечные победы и сила (прогресс таких игроков НЕ сохраняется,
	-- чтобы настоящее сохранение не испортилось). Перед релизом выключите.
	Infinite = {
		InStudio = true, -- у всех, кто тестирует в Studio
		ForOwner = true, -- у владельца игры и в опубликованной игре
		UserIds = {}, -- можно добавить номера аккаунтов, например { 123456 }
		Amount = 1e15,
	},

	-- «Мощный удар» (кнопка над полосой уровня): на время вся сила и урон умножаются
	PowerStrike = {
		Multiplier = 3,
		Duration = 15, -- секунд действует
		Cooldown = 60, -- секунд перезарядка (считается с момента включения)
	},

	-- Питомцы
	MaxEquippedPets = 3, -- сколько питомцев можно надеть одновременно
	MaxPetsInInventory = 60, -- размер инвентаря питомцев

	-- Редкий торговец на уровнях
	RareMerchant = {
		CheckInterval = 90, -- раз в сколько секунд пробуем его вызвать
		Chance = 0.35, -- шанс появления при каждой проверке (0.35 = 35%)
		Duration = 120, -- сколько секунд он стоит
		PriceMultiplier = 2, -- во сколько раз дороже покупает руды, чем обычный торговец
	},

	-- Стартовые значения нового игрока
	StartWins = 0,
	StartStrength = 0,
	StartPickaxe = "wood", -- Id кирки из PickaxeConfig

	-- Отладка: в Studio каждый новый игрок получает это количество побед (0 = выключено)
	StudioTestWins = 0,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002254"><Properties>
<string name="Name">IconConfig</string>
<ProtectedString name="Source"><![CDATA[--[[
	IconConfig — картинки для кнопок интерфейса.

	Пока здесь "rbxassetid://0", кнопки показывают эмодзи-заглушку.
	Как поставить настоящие иконки (из папки art/icons):
	1) Studio › View › Asset Manager › Bulk Import → выберите PNG-файлы.
	2) Правый клик по картинке в Asset Manager › Copy Asset ID.
	3) Вставьте сюда вместо 0, например "rbxassetid://1234567890".
]]

return {
	-- Слева 2×2 (фон-плитка и символ отдельно — символ анимируется)
	ShopTile = "rbxassetid://0", -- layer_tile_shop.png
	ShopSymbol = "rbxassetid://0", -- layer_sym_shop.png
	PetsTile = "rbxassetid://0", -- layer_tile_pets.png
	PetsSymbol = "rbxassetid://0", -- layer_sym_pets.png
	AurasTile = "rbxassetid://0", -- layer_tile_auras.png
	AurasSymbol = "rbxassetid://0", -- layer_sym_auras.png
	RebirthTile = "rbxassetid://0", -- layer_tile_rebirth.png
	RebirthSymbol = "rbxassetid://0", -- layer_sym_rebirth.png

	-- Колесо фортуны
	WheelBase = "rbxassetid://0", -- layer_wheel_base.png
	WheelDisc = "rbxassetid://0", -- layer_wheel_disc.png
	WheelTop = "rbxassetid://0", -- layer_wheel_top.png

	-- Правый верхний угол
	Achievements = "rbxassetid://0", -- bar_achievements.png
	Rewards = "rbxassetid://0", -- bar_rewards.png
	Quests = "rbxassetid://0", -- bar_daily.png (свиток)
	Settings = "rbxassetid://0", -- bar_settings.png

	-- Меч на полосе уровня и на кнопке «Мощный удар»
	LevelSword = "rbxassetid://0", -- icon_sword.png
	PowerSword = "rbxassetid://0", -- icon_sword_dark.png

	-- Показатели
	Strength = "rbxassetid://0", -- stat_strength.png (рука)
	Luck = "rbxassetid://0", -- stat_luck.png
	Wins = "rbxassetid://0", -- stat_wins.png

	-- Геймпассы
	PassWinsX3 = "rbxassetid://0", -- pass_wins_x3.png
	PassStrengthX2 = "rbxassetid://0", -- pass_strength_x2.png
	PassLuckX2 = "rbxassetid://0", -- pass_luck_x2.png
