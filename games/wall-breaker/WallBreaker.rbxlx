<Item class="LocalScript" referent="RBX002331"><Properties>
<string name="Name">ClientMain</string>
<ProtectedString name="Source"><![CDATA[--[[
	ClientMain — запуск клиентских систем (интерфейс, удары, эффекты, питомцы).
	Каждая система — отдельный модуль в папке Controllers.
]]
local Controllers = script:WaitForChild("Controllers")

local ORDER = { "State", "Toasts", "Panels", "Hud", "Popups", "World", "Swing", "Pets" }
for _, name in ipairs(ORDER) do
	local module = require(Controllers:WaitForChild(name))
	if module.Init then
		local ok, err = pcall(module.Init)
		if not ok then
			warn("[Client] " .. name .. ": " .. tostring(err))
		end
	end
end
]]></ProtectedString>
</Properties>
<Item class="Folder" referent="RBX002332"><Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="RBX002333"><Properties>
<string name="Name">Hud</string>
<ProtectedString name="Source"><![CDATA[--[[
	Hud — главный интерфейс: кнопки, показатели, колесо, панель уровня, анимации иконок.
	Сами кнопки лежат в StarterGui › MainHud — их можно двигать и перекрашивать в Studio.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = ReplicatedStorage:WaitForChild("Config")
local IconConfig = require(Config:WaitForChild("IconConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Controllers = script.Parent
local State = require(Controllers:WaitForChild("State"))
local Panels = require(Controllers:WaitForChild("Panels"))
local Toasts = require(Controllers:WaitForChild("Toasts"))

local Hud = {}
local gui: ScreenGui

local function find(path: string): Instance?
	local node: Instance? = gui
	for part in path:gmatch("[^%.]+") do
		node = node and node:FindFirstChild(part)
	end
	return node
end

local function setIcon(holder: Instance?, childName: string, key: string)
	if not holder then
		return
	end
	local image = holder:FindFirstChild(childName)
	local id = IconConfig[key]
	if image and image:IsA("ImageLabel") and id and id ~= "" and id ~= "rbxassetid://0" then
		image.Image = id
		image.Visible = true
		local fallback = holder:FindFirstChild("Fallback")
		if fallback and fallback:IsA("GuiObject") then
			fallback.Visible = false
		end
		-- если загружена картинка-плитка, убираем цветной фон кнопки
		if childName == "Tile" and holder:IsA("GuiObject") then
			holder.BackgroundTransparency = 1
			local stroke = holder:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Enabled = false
			end
		end
	end
end

local function applyIcons()
	setIcon(find("LeftMenu.ShopButton"), "Tile", "ShopTile")
	setIcon(find("LeftMenu.ShopButton"), "Symbol", "ShopSymbol")
	setIcon(find("LeftMenu.PetsButton"), "Tile", "PetsTile")
	setIcon(find("LeftMenu.PetsButton"), "Symbol", "PetsSymbol")
	setIcon(find("LeftMenu.AurasButton"), "Tile", "AurasTile")
	setIcon(find("LeftMenu.AurasButton"), "Symbol", "AurasSymbol")
	setIcon(find("LeftMenu.RebirthButton"), "Tile", "RebirthTile")
	setIcon(find("LeftMenu.RebirthButton"), "Symbol", "RebirthSymbol")
	setIcon(find("TopRight.WheelButton"), "Base", "WheelBase")
	setIcon(find("TopRight.WheelButton"), "Disc", "WheelDisc")
	setIcon(find("TopRight.WheelButton"), "Top", "WheelTop")
	setIcon(find("TopRight.AchievementsButton"), "Icon", "Achievements")
	setIcon(find("TopRight.RewardsButton"), "Icon", "Rewards")
	setIcon(find("TopRight.QuestsButton"), "Icon", "Quests")
	setIcon(find("TopRight.SettingsButton"), "Icon", "Settings")
	setIcon(find("Stats.StrengthRow"), "Icon", "Strength")
	setIcon(find("PowerPanel.LevelBar"), "Icon", "LevelSword")
	setIcon(find("PowerPanel.PowerStrikeButton"), "Icon", "PowerSword")
	setIcon(find("Stats.LuckRow"), "Icon", "Luck")
	setIcon(find("Stats.WinsRow"), "Icon", "Wins")
end

local function bindButton(path: string, panelName: string)
	local button = find(path)
	if button and button:IsA("GuiButton") then
		button.Activated:Connect(function()
			Panels.Toggle(panelName)
		end)
	end
end

local function setText(path: string, text: string)
	local label = find(path)
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
end

local XP_BUTTONS = { XpSmallButton = "xp_small", XpMediumButton = "xp_medium", XpBigButton = "xp_big" }

local function productFactor(key: string): number
	for _, p in ipairs(ShopConfig.Products) do
		if p.Key == key then
			return p.XpFactor or 1
		end
	end
	return 1
end

local function refreshStats()
	local data = State.Data
	if not data then
		return
	end
	local infinite = Players.LocalPlayer:GetAttribute("Infinite") == true
	setText("Stats.WinsRow.Value", infinite and "∞" or Format.Short(data.Wins))
	setText("Stats.StrengthRow.Value", infinite and "∞" or Format.Short(data.Strength))
	setText("Stats.LuckRow.Value", Format.Short(Formulas.LuckPercent(data, State.HasPass("LuckX2"))) .. "%")
	setText("Stats.RebirthRow.Value", tostring(data.Rebirths))
	-- большая надпись силы и полоса уровня
	setText("PowerPanel.StrengthBig", (infinite and "∞" or Format.Short(data.Strength)) .. " Сила")
	local level = data.PlayerLevel or 1
	local need = Formulas.XpForLevel(level)
	setText("PowerPanel.LevelBar.Level", "Уровень " .. tostring(level))
	setText("PowerPanel.LevelBar.Xp", ("%s / %s"):format(Format.Short(data.Xp or 0), Format.Short(need)))
	local fill = find("PowerPanel.LevelBar.Fill")
	if fill and fill:IsA("GuiObject") then
		fill.Size = UDim2.new(math.clamp((data.Xp or 0) / need, 0.02, 1), 0, 1, 0)
	end
	for buttonName, key in pairs(XP_BUTTONS) do
		setText("PowerPanel.XpButtons." .. buttonName, ("+%s очков\nопыта"):format(Format.Short(need * productFactor(key))))
	end
end

local function refreshTimers()
	-- «Мощный удар»: активен / перезарядка / готов
	local strikeText = find("PowerPanel.PowerStrikeButton.Text")
	if strikeText and strikeText:IsA("TextLabel") then
		local active = State.Countdown("PowerStrikeActiveFor")
		local ready = State.Countdown("PowerStrikeReadyIn")
		if active > 0 then
			strikeText.Text = ("Активен\n%d сек"):format(math.ceil(active))
		elseif ready > 0 then
			strikeText.Text = ("Готов через\n%d сек"):format(math.ceil(ready))
		else
			strikeText.Text = "Мощный\nудар"
		end
	end
	-- значок «1» на наградах, когда ежедневная награда готова
	local badge = find("TopRight.RewardsButton.Badge")
	if badge and badge:IsA("GuiObject") then
		badge.Visible = State.Data ~= nil and State.Countdown("DailyReadyIn") <= 0
	end
end

-- Анимации иконок (покачивание, прыжки, пульсация, вращение)
local baseState = {}
local function remember(obj: GuiObject?)
	if obj and not baseState[obj] then
		baseState[obj] = { Position = obj.Position, Size = obj.Size, Rotation = obj.Rotation }
	end
	return obj
end

local function animate(t: number)
	local function sym(button: string, child: string): GuiObject?
		local holder = find("LeftMenu." .. button)
		local obj = holder and (holder:FindFirstChild(child) :: GuiObject?)
		return remember(obj)
	end
	for i, name in ipairs({ "ShopButton", "PetsButton", "AurasButton", "RebirthButton" }) do
		local btn = find("LeftMenu." .. name) :: GuiObject?
		local scale = btn and btn:FindFirstChild("Pulse")
		if scale and scale:IsA("UIScale") then
			scale.Scale = 1 + 0.035 * math.sin(t * 3 + i * 1.3)
		end
		-- символ и запасной эмодзи анимируются одинаково
		for _, child in ipairs({ "Symbol", "Fallback" }) do
			local obj = sym(name, child)
			if obj and baseState[obj] then
				local base = baseState[obj]
				if name == "ShopButton" then
					obj.Rotation = 7 * math.sin(t * 2.6)
				elseif name == "PetsButton" then
					obj.Position = base.Position + UDim2.fromOffset(0, -8 * math.abs(math.sin(t * 3.2)))
				elseif name == "AurasButton" then
					local k = 1 + 0.08 * math.sin(t * 7)
					obj.Size = UDim2.new(base.Size.X.Scale * k, base.Size.X.Offset * k, base.Size.Y.Scale * k, base.Size.Y.Offset * k)
				elseif name == "RebirthButton" then
					obj.Rotation = (t * 90) % 360
				end
			end
		end
	end
	-- колесо фортуны и значок «!»
	local wheel = find("TopRight.WheelButton")
	if wheel then
		for _, child in ipairs({ "Disc", "Fallback" }) do
			local d = wheel:FindFirstChild(child)
			if d and d:IsA("GuiObject") then
				d.Rotation = (t * 50) % 360
			end
		end
		local badge = wheel:FindFirstChild("Badge")
		local bScale = badge and badge:FindFirstChildOfClass("UIScale")
		if bScale then
			bScale.Scale = 1 + 0.22 * math.max(0, math.sin(t * 6))
		end
	end
	-- маленькие кнопки справа сверху покачиваются
	local small = find("TopRight")
	if small then
		for i, name in ipairs({ "SettingsButton", "QuestsButton", "RewardsButton" }) do
			local btn = small:FindFirstChild(name)
			if btn then
				for _, child in ipairs({ "Icon", "Fallback" }) do
					local obj = remember(btn:FindFirstChild(child) :: GuiObject?)
					if obj and baseState[obj] then
						obj.Position = baseState[obj].Position + UDim2.fromOffset(0, -3 * math.sin(t * 2.6 + i * 0.9))
						if name == "SettingsButton" then
							obj.Rotation = (t * 40) % 360
						elseif name == "RewardsButton" then
							obj.Rotation = (t % 2.4) < 0.6 and 12 * math.sin(t * 28) or 0
						end
					end
				end
			end
		end
	end
	-- иконка силы «замахивается»
	local strengthIcon = find("Stats.StrengthRow.Icon")
	if strengthIcon and strengthIcon:IsA("GuiObject") then
		strengthIcon.Rotation = -14 * math.max(0, math.sin(t * 5))
	end
end

local function updateWheelBadge()
	local badge = find("TopRight.WheelButton.Badge")
	if badge and badge:IsA("GuiObject") and State.Data then
		badge.Visible = State.Countdown("WheelReadyIn") <= 0 or State.Data.Wheel.ExtraSpins > 0
	end
end

local function onLevelState(info)
	local panel = find("LevelPanel")
	if not panel or not panel:IsA("GuiObject") then
		return
	end
	if not info then
		panel.Visible = false
		return
	end
	panel.Visible = true
	setText("LevelPanel.Title", ("Уровень %d · %s"):format(info.Level, info.Name))
	setText("LevelPanel.Sub", "Рекомендуемая сила: " .. Format.Short(info.Recommended))
	local fill = find("LevelPanel.Bar.Fill")
	if fill and fill:IsA("GuiObject") then
		fill.Size = UDim2.new(math.clamp(info.Layer / info.Layers, 0, 1), 0, 1, 0)
	end
	if info.Layer >= info.Layers then
		setText("LevelPanel.Bar.BarText", "Стена пройдена! Награда — в нише справа")
	else
		setText("LevelPanel.Bar.BarText", ("Слой %d / %d · прочность %s / %s"):format(info.Layer + 1, info.Layers, Format.Short(info.HP), Format.Short(info.MaxHP)))
	end
end

local function fitScale()
	local scale = gui:FindFirstChild("Scale")
	local camera = Workspace.CurrentCamera
	if scale and scale:IsA("UIScale") and camera then
		scale.Scale = math.clamp(camera.ViewportSize.Y / 760, 0.75, 1.15)
	end
end

function Hud.Init()
	gui = Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("MainHud") :: ScreenGui
	applyIcons()
	bindButton("LeftMenu.ShopButton", "ShopPanel")
	bindButton("LeftMenu.PetsButton", "PetsPanel")
	bindButton("LeftMenu.AurasButton", "AurasPanel")
	bindButton("LeftMenu.RebirthButton", "RebirthPanel")
	bindButton("TopRight.WheelButton", "WheelPanel")
	bindButton("TopRight.AchievementsButton", "AchievementsPanel")
	bindButton("TopRight.RewardsButton", "RewardsPanel")
	bindButton("TopRight.QuestsButton", "QuestsPanel")
	bindButton("TopRight.SettingsButton", "SettingsPanel")

	State.Changed:Connect(function()
		refreshStats()
		refreshTimers()
		updateWheelBadge()
	end)

	-- Кнопки опыта (Robux) и «Мощный удар»
	local function request(action: string, ...)
		local res = State.Request(action, ...)
		if res and res.msg then
			Toasts.Show(res.msg, res.ok and "info" or "error")
		end
	end
	for buttonName, key in pairs(XP_BUTTONS) do
		local b = find("PowerPanel.XpButtons." .. buttonName)
		if b and b:IsA("GuiButton") then
			b.Activated:Connect(function()
				request("BuyProduct", key)
			end)
		end
	end
	local strike = find("PowerPanel.PowerStrikeButton")
	if strike and strike:IsA("GuiButton") then
		strike.Activated:Connect(function()
			request("PowerStrike")
		end)
	end
	Remotes.Event("LevelState").OnClientEvent:Connect(onLevelState)

	fitScale()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(fitScale)
	end

	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		animate(os.clock())
		acc += dt
		if acc > 1 then
			acc = 0
			updateWheelBadge()
			refreshTimers()
		end
	end)
end

return Hud
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002334"><Properties>
<string name="Name">Panels</string>
<ProtectedString name="Source"><![CDATA[--[[
	Panels — окна магазина, питомцев, аур, перерождения, колеса, наград, заданий, достижений, настроек.

	Каждое окно лежит в StarterGui › MainHud › Panels. Внутри окна есть скрытая карточка "Template":
	её можно перекрасить и передвинуть элементы — все карточки в списке будут такими же.
]]
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PickaxeConfig = require(Config:WaitForChild("PickaxeConfig"))
local AuraConfig = require(Config:WaitForChild("AuraConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local WheelConfig = require(Config:WaitForChild("WheelConfig"))
local RewardsConfig = require(Config:WaitForChild("RewardsConfig"))
local RebirthConfig = require(Config:WaitForChild("RebirthConfig"))
local PetConfig = require(Config:WaitForChild("PetConfig"))
local IconConfig = require(Config:WaitForChild("IconConfig"))
local Settings = require(Config:WaitForChild("GameSettings"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Formulas = require(Shared:WaitForChild("Formulas"))
local Catalog = require(Shared:WaitForChild("Catalog"))

local Controllers = script.Parent
local State = require(Controllers:WaitForChild("State"))
local Toasts = require(Controllers:WaitForChild("Toasts"))

local Panels = {}
local root: Frame
local openName: string? = nil
local shopTab = "Luck"
local spinning = false
local traderMult = 1
local traderSelected: { [string]: boolean } = {}

local COLOR_BUY = Color3.fromRGB(61, 200, 110)
local COLOR_EQUIP = Color3.fromRGB(63, 140, 255)
local COLOR_DONE = Color3.fromRGB(120, 120, 145)
local COLOR_SPECIAL = Color3.fromRGB(166, 91, 255)

local function panel(name: string): Frame?
	return root and root:FindFirstChild(name) :: Frame?
end

local function act(action: string, ...)
	local res = State.Request(action, ...)
	if res and res.msg then
		Toasts.Show(res.msg, res.ok and "info" or "error")
	end
	return res
end

local function clearList(p: Instance)
	local content = p:FindFirstChild("Content")
	if not content then
		return
	end
	for _, child in ipairs(content:GetChildren()) do
		if child.Name == "Item" then
			child:Destroy()
		end
	end
end

type CardOptions = {
	name: string,
	info: string?,
	fallback: string?,
	image: string?,
	color: Color3?,
	button: string?,
	buttonColor: Color3?,
	onClick: (() -> ())?,
	order: number?,
	highlight: boolean?,
}

local function addCard(p: Instance, o: CardOptions): Frame?
	local template = p:FindFirstChild("Template")
	local content = p:FindFirstChild("Content")
	if not template or not content then
		return nil
	end
	local card = template:Clone() :: Frame
	card.Name = "Item"
	card.Visible = true
	card.LayoutOrder = o.order or 0
	local function text(name: string, value: string?)
		local l = card:FindFirstChild(name)
		if l and l:IsA("TextLabel") then
			l.Text = value or ""
		end
	end
	text("NameLabel", o.name)
	text("InfoLabel", o.info)
	local fallback = card:FindFirstChild("Fallback")
	if fallback and fallback:IsA("TextLabel") then
		fallback.Text = o.fallback or ""
		if o.color then
			fallback.TextColor3 = o.color
		end
	end
	local icon = card:FindFirstChild("Icon")
	if icon and icon:IsA("ImageLabel") and o.image and o.image ~= "rbxassetid://0" then
		icon.Image = o.image
		icon.Visible = true
		if fallback and fallback:IsA("GuiObject") then
			fallback.Visible = false
		end
	end
	if o.highlight then
		local stroke = card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = Color3.fromRGB(255, 225, 77)
		end
	end
	local button = card:FindFirstChild("ActionButton")
	if button and button:IsA("TextButton") then
		if o.button then
			button.Text = o.button
			button.BackgroundColor3 = o.buttonColor or COLOR_BUY
			if o.onClick then
				button.Activated:Connect(o.onClick)
			end
		else
			button.Visible = false
		end
	end
	card.Parent = content
	return card
end

local function setLabel(p: Instance, name: string, value: string)
	local l = p:FindFirstChild(name, true)
	if l and (l:IsA("TextLabel") or l:IsA("TextButton")) then
		l.Text = value
	end
end

-- ===== Магазин =====
local function fillShop(p: Frame)
	local data = State.Data
	for _, tab in ipairs({ "Luck", "Donate" }) do
		local tabs = p:FindFirstChild("Tabs")
		local b = tabs and tabs:FindFirstChild(tab .. "Tab")
		if b and b:IsA("TextButton") then
			b.BackgroundColor3 = tab == shopTab and Color3.fromRGB(255, 196, 61) or Color3.fromRGB(90, 70, 160)
		end
	end
	if shopTab == "Luck" then
		local maxed = data.LuckPercent >= ShopConfig.Luck.MaxPercent
		for i, offer in ipairs(ShopConfig.Luck.Offers) do
			local cost = Formulas.LuckOfferCost(offer, data.LuckBought[offer.Id] or 0)
			addCard(p, {
				name = offer.Name,
				info = ("+%d%% удачи · сейчас %s%%"):format(offer.Percent, Format.Short(Formulas.LuckPercent(data, State.HasPass("LuckX2")))),
				fallback = offer.Emoji or "🍀",
				image = i == 1 and IconConfig.Luck or nil,
				button = maxed and "Максимум" or ("🏆 " .. Format.Short(cost)),
				buttonColor = maxed and COLOR_DONE or (data.Wins >= cost and COLOR_BUY or COLOR_DONE),
				onClick = function()
					act("BuyLuck", offer.Id)
				end,
				order = i,
			})
		end
	else
		for i, key in ipairs(ShopConfig.GamePassOrder) do
			local pass = ShopConfig.GamePasses[key]
			local has = State.HasPass(key)
			addCard(p, {
				name = pass.Name,
				info = pass.Description,
				fallback = "⭐",
				image = IconConfig[pass.Icon],
				button = has and "Куплено" or "Купить",
				buttonColor = has and COLOR_DONE or COLOR_SPECIAL,
				onClick = function()
					if not has then
						act("BuyPass", key)
					end
				end,
				order = i,
			})
		end
		for i, product in ipairs(ShopConfig.Products) do
			if product.Hidden then
				continue
			end
			addCard(p, {
				name = product.Name,
				info = "Можно покупать много раз",
				fallback = product.Spins and "🎡" or "🏆",
				button = "Купить",
				buttonColor = COLOR_SPECIAL,
				onClick = function()
					act("BuyProduct", product.Key)
				end,
				order = 100 + i,
			})
		end
	end
end

-- ===== Питомцы =====
local function fillPets(p: Frame)
	local data = State.Data
	setLabel(p, "Info", ("Надето %d/%d · множитель силы ×%s · яйца стоят в лобби у южной стены"):format(
		#data.EquippedPets,
		Settings.MaxEquippedPets,
		Format.Short(Formulas.PetMultiplier(data))
	))
	local pets = table.clone(data.Pets)
	table.sort(pets, function(a, b)
		local da, db = Catalog.Pets[a.Id], Catalog.Pets[b.Id]
		return (da and da.Multiplier or 0) > (db and db.Multiplier or 0)
	end)
	if #pets == 0 then
		addCard(p, { name = "Пока нет питомцев", info = "Открой яйцо в лобби!", fallback = "🥚" })
	end
	for i, pet in ipairs(pets) do
		local def = PetConfig.Pets[pet.Id]
		if def then
			local equipped = table.find(data.EquippedPets, pet.Uid) ~= nil
			local card = addCard(p, {
				name = def.Name,
				info = ("%s · x%s Силы"):format(def.Rarity, tostring(def.Multiplier)),
				fallback = def.Emoji or "🐾",
				color = def.Color,
				button = equipped and "Снять" or "Надеть",
				buttonColor = equipped and COLOR_DONE or COLOR_EQUIP,
				onClick = function()
					act(equipped and "UnequipPet" or "EquipPet", pet.Uid)
				end,
				order = i,
				highlight = equipped,
			})
			local del = card and card:FindFirstChild("DeleteButton")
			if del and del:IsA("TextButton") then
				del.Activated:Connect(function()
					act("DeletePet", pet.Uid)
				end)
			end
		end
	end
end

-- ===== Ауры =====
local function fillAuras(p: Frame)
	local data = State.Data
	for i, aura in ipairs(AuraConfig.Auras) do
		local owned = data.Auras[aura.Id]
		local equipped = data.EquippedAura == aura.Id
		local label
		if equipped then
			label = "Снять"
		elseif owned then
			label = "Надеть"
		elseif aura.Price > 0 then
			label = "Купить"
		else
			label = "Колесо"
		end
		addCard(p, {
			name = aura.Name,
			info = ("Сила ×%s · %s"):format(tostring(aura.Multiplier), owned and "есть" or (aura.Price > 0 and (Format.Short(aura.Price) .. " побед") or "только из колеса")),
			fallback = "✨",
			color = aura.Color,
			button = label,
			buttonColor = equipped and COLOR_DONE or (owned and COLOR_EQUIP or (aura.Price > 0 and COLOR_BUY or COLOR_SPECIAL)),
			onClick = function()
				if equipped then
					act("EquipAura", "")
				elseif owned then
					act("EquipAura", aura.Id)
				elseif aura.Price > 0 then
					act("BuyAura", aura.Id)
				else
					Panels.Open("WheelPanel")
				end
			end,
			order = i,
			highlight = equipped,
		})
	end
end

-- ===== Перерождение =====
local function fillRebirth(p: Frame)
	local data = State.Data
	local cost = State.Snapshot.RebirthCost or Formulas.RebirthCost(data.Rebirths)
	local needLevel = State.Snapshot.RebirthLevel or Formulas.RebirthLevel(data.Rebirths)
	setLabel(p, "Info", ("Перерождений: %d\n\nНужен уровень: %d (сейчас %d)%s\nНаграда: +%d%% силы навсегда (сейчас ×%s) и новые ямы\n\nСбросится: сила, уровень, кирки и стены.\nОстанутся: питомцы, ауры, удача и победы."):format(
		data.Rebirths,
		needLevel,
		data.PlayerLevel or 1,
		cost > 0 and ("\nЦена: " .. Format.Short(cost) .. " побед") or "",
		math.floor(RebirthConfig.StrengthBonusPerRebirth * 100),
		tostring(Formulas.RebirthMultiplier(data))
	))
	setLabel(p, "RebirthButton", (data.PlayerLevel or 1) >= needLevel and "Переродиться!" or ("Нужен уровень " .. needLevel))
end

-- ===== Колесо =====
local wheelBuilt = false
local function buildWheel(p: Frame)
	if wheelBuilt then
		return
	end
	local disc = p:FindFirstChild("Disc", true)
	if not disc then
		return
	end
	wheelBuilt = true
	local discImage = disc:FindFirstChild("DiscImage")
	if discImage and discImage:IsA("ImageLabel") and IconConfig.WheelDisc ~= "rbxassetid://0" then
		discImage.Image = IconConfig.WheelDisc
	end
	local n = #WheelConfig.Prizes
	for i, prize in ipairs(WheelConfig.Prizes) do
		local a = math.rad((i - 0.5) * 360 / n)
		local label = Instance.new("TextLabel")
		label.Name = "Prize" .. i
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Size = UDim2.fromScale(0.3, 0.12)
		label.Position = UDim2.fromScale(0.5 + 0.33 * math.sin(a), 0.5 - 0.33 * math.cos(a))
		label.Rotation = math.deg(a)
		label.BackgroundColor3 = prize.Color
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Text = prize.Text
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.4, 0)
		corner.Parent = label
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.fromRGB(26, 16, 51)
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = label
		label.Parent = disc
	end
	local buy = p:FindFirstChild("BuySpinButton", true)
	if buy and buy:IsA("GuiButton") then
		buy.Activated:Connect(function()
			act("BuyProduct", "spin")
		end)
	end
	local spin = p:FindFirstChild("SpinButton", true)
	if spin and spin:IsA("TextButton") then
		spin.Activated:Connect(function()
			if spinning then
				return
			end
			spinning = true
			local res = State.Request("SpinWheel")
			if not res or not res.ok then
				spinning = false
				if res and res.msg then
					Toasts.Show(res.msg, "error")
				end
				return
			end
			local d = disc :: GuiObject
			local center = (res.index - 0.5) * 360 / n
			local current = d.Rotation % 360
			local target = d.Rotation - current + 360 * 5 + (360 - center)
			local tween = TweenService:Create(d, TweenInfo.new(4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = target })
			tween:Play()
			tween.Completed:Wait()
			Toasts.Show("Выигрыш: " .. res.text, "wins")
			spinning = false
		end)
	end
end

local function fillWheel(p: Frame)
	buildWheel(p)
	local data = State.Data
	local remaining = State.Countdown("WheelReadyIn")
	local text
	if remaining <= 0 then
		text = "Бесплатное вращение готово!"
	else
		text = "Бесплатно через " .. Format.Time(remaining)
	end
	if data.Wheel.ExtraSpins > 0 then
		text ..= ("  ·  доп. вращений: %d"):format(data.Wheel.ExtraSpins)
	end
	setLabel(p, "Timer", text)
	-- если бесплатное вращение ещё не готово — показываем кнопку покупки за Robux
	local free = remaining <= 0 or data.Wheel.ExtraSpins > 0
	local spin = p:FindFirstChild("SpinButton", true)
	local buy = p:FindFirstChild("BuySpinButton", true)
	if spin and spin:IsA("TextButton") then
		spin.Text = free and "Крутить!" or Format.Time(remaining)
		spin.BackgroundColor3 = free and Color3.fromRGB(255, 160, 40) or COLOR_DONE
	end
	if buy and buy:IsA("GuiObject") then
		buy.Visible = not free
	end
end

-- ===== Ежедневные награды =====
local function fillRewards(p: Frame)
	local data = State.Data
	local remaining = State.Countdown("DailyReadyIn")
	local list = RewardsConfig.DailyRewards
	local nextDay = ((data.Daily.Streak) % #list) + 1
	for i, reward in ipairs(list) do
		addCard(p, {
			name = "День " .. i,
			info = "+" .. Format.Short(reward) .. " побед",
			fallback = "🎁",
			order = i,
			highlight = i == nextDay,
		})
	end
	setLabel(p, "Info", remaining <= 0 and "Награда готова!" or ("Следующая награда через " .. Format.Time(remaining)))
	setLabel(p, "ClaimButton", remaining <= 0 and "Забрать" or Format.Time(remaining))
end

-- ===== Задания и достижения =====
local function fillQuests(p: Frame)
	local data = State.Data
	local progress = State.Snapshot.QuestProgress or {}
	for i, quest in ipairs(RewardsConfig.DailyQuests) do
		local value = math.min(progress[quest.Id] or 0, quest.Goal)
		local claimed = data.Quests.Claimed[quest.Id]
		local done = value >= quest.Goal
		addCard(p, {
			name = quest.Text,
			info = ("%s / %s · награда %s побед"):format(Format.Short(value), Format.Short(quest.Goal), Format.Short(quest.Reward)),
			fallback = "📅",
			button = claimed and "Получено" or (done and "Забрать" or "В процессе"),
			buttonColor = claimed and COLOR_DONE or (done and COLOR_BUY or COLOR_DONE),
			onClick = function()
				if done and not claimed then
					act("ClaimQuest", quest.Id)
				end
			end,
			order = i,
		})
	end
	setLabel(p, "Info", "Новые задания через " .. Format.Time(State.Countdown("QuestResetIn")))
end

local function fillAchievements(p: Frame)
	local data = State.Data
	for i, ach in ipairs(RewardsConfig.Achievements) do
		local value = math.min(data.Stats[ach.Stat] or 0, ach.Goal)
		local claimed = data.Achievements[ach.Id]
		local done = value >= ach.Goal
		addCard(p, {
			name = ach.Text,
			info = ("%s / %s · награда %s побед"):format(Format.Short(value), Format.Short(ach.Goal), Format.Short(ach.Reward)),
			fallback = "🏆",
			button = claimed and "Получено" or (done and "Забрать" or "В процессе"),
			buttonColor = claimed and COLOR_DONE or (done and COLOR_BUY or COLOR_DONE),
			onClick = function()
				if done and not claimed then
					act("ClaimAchievement", ach.Id)
				end
			end,
			order = 100 + (claimed and 1000 or 0) + i,
		})
	end
end

local function fillSettings(p: Frame)
	local data = State.Data
	local hasAuto = State.HasPass("AutoClick")
	addCard(p, {
		name = "Автоклик",
		info = hasAuto and "Кирка бьёт сама, пока она в руках" or "Нужен геймпасс «Автоклик» (Магазин › Донат)",
		fallback = "🤖",
		button = hasAuto and (data.Settings.AutoClick and "Вкл" or "Выкл") or "Магазин",
		buttonColor = (hasAuto and data.Settings.AutoClick) and COLOR_BUY or COLOR_DONE,
		onClick = function()
			if hasAuto then
				act("SetSetting", "AutoClick", not data.Settings.AutoClick)
			else
				shopTab = "Donate"
				Panels.Open("ShopPanel")
			end
		end,
		order = 1,
	})
	addCard(p, {
		name = "Показывать питомцев",
		info = "Питомцы других игроков",
		fallback = "🐾",
		button = data.Settings.ShowPets and "Вкл" or "Выкл",
		buttonColor = data.Settings.ShowPets and COLOR_BUY or COLOR_DONE,
		onClick = function()
			act("SetSetting", "ShowPets", not data.Settings.ShowPets)
		end,
		order = 2,
	})
	addCard(p, {
		name = "Вернуться в лобби",
		info = "Телепорт к яйцам и ямам",
		fallback = "🏠",
		button = "В лобби",
		buttonColor = COLOR_EQUIP,
		onClick = function()
			act("GoToLobby")
			Panels.Close()
		end,
		order = 3,
	})
end

-- ===== Торговец рудами =====
local function fillTrader(p: Frame)
	local data = State.Data
	local OreConfig = require(Config:WaitForChild("OreConfig"))
	local total, selectedTotal, any = 0, 0, false
	for i, ore in ipairs(OreConfig.Ores) do
		local n = data.Ores[ore.Id] or 0
		if n > 0 then
			any = true
			local price = ore.Price * traderMult
			total += price * n
			local selected = traderSelected[ore.Id] == true
			if selected then
				selectedTotal += price * n
			end
			addCard(p, {
				name = ("%s ×%d"):format(ore.Name, n),
				info = ("%s 🏆 за штуку · всего %s 🏆"):format(Format.Short(price), Format.Short(price * n)),
				fallback = "⬤",
				color = ore.Color,
				button = selected and "✓ Выбрано" or "Выбрать",
				buttonColor = selected and COLOR_BUY or COLOR_DONE,
				onClick = function()
					traderSelected[ore.Id] = not selected or nil
					Panels.Refresh()
				end,
				order = i,
				highlight = selected,
			})
		end
	end
	if not any then
		addCard(p, { name = "Нет руд", info = "Ломай стены — руды выпадают из слоёв", fallback = "⛏" })
	end
	setLabel(p, "Total", ("Выбрано: %s 🏆  ·  Всё: %s 🏆%s"):format(
		Format.Short(selectedTotal),
		Format.Short(total),
		traderMult > 1 and ("  (цены ×" .. tostring(traderMult) .. ")") or ""
	))
end

local FILLERS = {
	TraderPanel = fillTrader,
	ShopPanel = fillShop,
	PetsPanel = fillPets,
	AurasPanel = fillAuras,
	RebirthPanel = fillRebirth,
	WheelPanel = fillWheel,
	RewardsPanel = fillRewards,
	QuestsPanel = function(p)
		fillQuests(p)
		fillAchievements(p) -- достижения в том же окне, ниже заданий
	end,
	AchievementsPanel = fillAchievements,
	SettingsPanel = fillSettings,
}

function Panels.Refresh()
	if not openName or not State.Data then
		return
	end
	local p = panel(openName)
	local filler = FILLERS[openName]
	if p and filler then
		clearList(p)
		filler(p)
	end
end

function Panels.Open(name: string)
	if not root then
		return
	end
	for _, child in ipairs(root:GetChildren()) do
		if child:IsA("GuiObject") then
			child.Visible = child.Name == name
		end
	end
	openName = name
	local p = panel(name)
	if p then
		local scale = p:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 0.85
			TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
	end
	Panels.Refresh()
end

function Panels.Close()
	if not root then
		return
	end
	for _, child in ipairs(root:GetChildren()) do
		if child:IsA("GuiObject") then
			child.Visible = false
		end
	end
	openName = nil
end

function Panels.Toggle(name: string)
	if openName == name then
		Panels.Close()
	else
		Panels.Open(name)
	end
end

function Panels.Init()
	local gui = Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("MainHud")
	root = gui:WaitForChild("Panels") :: Frame
	for _, p in ipairs(root:GetChildren()) do
		local close = p:FindFirstChild("CloseButton", true)
		if close and close:IsA("GuiButton") then
			close.Activated:Connect(Panels.Close)
		end
		local template = p:FindFirstChild("Template")
		if template and template:IsA("GuiObject") then
			template.Visible = false
		end
	end
	-- Вкладки магазина
	local shop = panel("ShopPanel")
	local tabs = shop and shop:FindFirstChild("Tabs")
	if tabs then
		for _, tab in ipairs({ "Luck", "Donate" }) do
			local b = tabs:FindFirstChild(tab .. "Tab")
			if b and b:IsA("GuiButton") then
				b.Activated:Connect(function()
					shopTab = tab
					Panels.Refresh()
				end)
			end
		end
	end
	-- Кнопки окон
	local pets = panel("PetsPanel")
	local best = pets and pets:FindFirstChild("EquipBestButton", true)
	if best and best:IsA("GuiButton") then
		best.Activated:Connect(function()
			act("EquipBestPets")
		end)
	end
	local rebirth = panel("RebirthPanel")
	local rb = rebirth and rebirth:FindFirstChild("RebirthButton", true)
	if rb and rb:IsA("GuiButton") then
		rb.Activated:Connect(function()
			act("Rebirth")
		end)
	end
	-- Торговец: выделить все / продать выбранное / продать все
	local trader = panel("TraderPanel")
	if trader then
		local function bindT(name: string, fn)
			local b = trader:FindFirstChild(name, true)
			if b and b:IsA("GuiButton") then
				b.Activated:Connect(fn)
			end
		end
		bindT("SelectAllButton", function()
			local OreConfig = require(Config:WaitForChild("OreConfig"))
			local all = true
			for _, ore in ipairs(OreConfig.Ores) do
				if (State.Data.Ores[ore.Id] or 0) > 0 and not traderSelected[ore.Id] then
					all = false
				end
			end
			for _, ore in ipairs(OreConfig.Ores) do
				traderSelected[ore.Id] = (not all) or nil
			end
			Panels.Refresh()
		end)
		bindT("SellSelectedButton", function()
			local ids = {}
			for id in pairs(traderSelected) do
				table.insert(ids, id)
			end
			if #ids == 0 then
				Toasts.Show("Сначала выбери руды", "error")
				return
			end
			act("SellOres", ids)
			traderSelected = {}
		end)
		bindT("SellAllButton", function()
			act("SellOres", nil)
			traderSelected = {}
		end)
	end
	game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Effect").OnClientEvent:Connect(function(kind, a)
		if kind == "OpenTrader" then
			traderMult = a or 1
			traderSelected = {}
			Panels.Open("TraderPanel")
		end
	end)

	local rewards = panel("RewardsPanel")
	local claim = rewards and rewards:FindFirstChild("ClaimButton", true)
	if claim and claim:IsA("GuiButton") then
		claim.Activated:Connect(function()
			act("ClaimDaily")
		end)
	end

	Panels.Close()
	State.Changed:Connect(function()
		if openName ~= "WheelPanel" or not spinning then
			Panels.Refresh()
		end
	end)
	-- Таймеры обновляются раз в секунду
	task.spawn(function()
		while true do
			task.wait(1)
			if openName == "WheelPanel" or openName == "RewardsPanel" or openName == "QuestsPanel" then
				if not spinning then
					Panels.Refresh()
				end
			end
		end
	end)
end

return Panels
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002335"><Properties>
<string name="Name">Pets</string>
<ProtectedString name="Source"><![CDATA[--[[
	Pets — рисует питомцев рядом с игроками (только на экране, сервер не нагружается).
	Своя модель: ReplicatedStorage › PetModels › <Id питомца> (Model). Иначе — круглый питомец.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Catalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Catalog"))
local Controllers = script.Parent
local State = require(Controllers:WaitForChild("State"))

local Pets = {}
local folder: Folder
local shown: { [Player]: { key: string, models: { Model } } } = {}

local function makePet(id: string): Model
	local custom = ReplicatedStorage:FindFirstChild("PetModels")
	local template = custom and custom:FindFirstChild(id)
	if template and template:IsA("Model") then
		local m = template:Clone()
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
			end
		end
		return m
	end
	local def = Catalog.Pets[id]
	local model = Instance.new("Model")
	model.Name = id
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.new(2, 2, 2)
	body.Color = def and def.Color or Color3.new(1, 1, 1)
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.Parent = model
	model.PrimaryPart = body
	for _, x in ipairs({ -0.4, 0.4 }) do
		local eye = Instance.new("Part")
		eye.Name = "Eye"
		eye.Shape = Enum.PartType.Ball
		eye.Size = Vector3.new(0.4, 0.4, 0.4)
		eye.Color = Color3.fromRGB(26, 16, 51)
		eye.Anchored = true
		eye.CanCollide = false
		eye.CanQuery = false
		eye.CFrame = body.CFrame * CFrame.new(x, 0.25, -0.85)
		eye.Parent = model
	end
	for _, x in ipairs({ -0.55, 0.55 }) do
		local ear = Instance.new("Part")
		ear.Name = "Ear"
		ear.Size = Vector3.new(0.4, 0.7, 0.3)
		ear.Color = body.Color
		ear.Anchored = true
		ear.CanCollide = false
		ear.CanQuery = false
		ear.CFrame = body.CFrame * CFrame.new(x, 1, 0)
		ear.Parent = model
	end
	return model
end

local function sync(player: Player)
	local key = player:GetAttribute("EquippedPets") or ""
	local data = State.Data
	if player ~= Players.LocalPlayer and data and data.Settings.ShowPets == false then
		key = ""
	end
	local entry = shown[player]
	if entry and entry.key == key then
		return
	end
	if entry then
		for _, m in ipairs(entry.models) do
			m:Destroy()
		end
	end
	local models = {}
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	for id in tostring(key):gmatch("[^,]+") do
		local m = makePet(id)
		if root then
			m:PivotTo(root.CFrame * CFrame.new(0, 0, 5))
		end
		m.Parent = folder
		table.insert(models, m)
	end
	shown[player] = { key = key, models = models }
end

function Pets.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientPets"
	folder.Parent = Workspace

	local function watch(player: Player)
		player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
			sync(player)
		end)
		sync(player)
	end
	Players.PlayerAdded:Connect(watch)
	for _, p in ipairs(Players:GetPlayers()) do
		watch(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		local entry = shown[player]
		if entry then
			for _, m in ipairs(entry.models) do
				m:Destroy()
			end
		end
		shown[player] = nil
	end)
	State.Changed:Connect(function()
		for _, p in ipairs(Players:GetPlayers()) do
			sync(p)
		end
	end)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for player, entry in pairs(shown) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local n = #entry.models
				for i, model in ipairs(entry.models) do
					local spread = (i - (n + 1) / 2) * 3.2
					local bob = math.sin(t * 4 + i) * 0.35
					local target = root.CFrame * CFrame.new(spread, -1 + bob, 5.5)
					local current = model:GetPivot()
					model:PivotTo(current:Lerp(target, 0.15))
				end
			end
		end
	end)
end

return Pets
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002336"><Properties>
<string name="Name">Popups</string>
<ProtectedString name="Source"><![CDATA[--[[
	Popups — яйца:
	• EggPreview — когда подходишь к яйцу, появляется окно: какие питомцы могут выпасть,
	  их множители и шансы, и зелёная кнопка «Открыть».
	• EggOpen — анимация открытия как у кейсов: лента с питомцами быстро прокручивается,
	  замедляется и останавливается на выпавшем питомце, карточка увеличивается.
	Внешний вид: StarterGui › MainHud › EggPreview и EggOpen (можно перекрашивать в Studio).
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = ReplicatedStorage:WaitForChild("Config")
local PetConfig = require(Config:WaitForChild("PetConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared:WaitForChild("Catalog"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Controllers = script.Parent
local State = require(Controllers:WaitForChild("State"))
local Toasts = require(Controllers:WaitForChild("Toasts"))

local Popups = {}
local gui: ScreenGui
local player = Players.LocalPlayer
local currentEgg = nil -- конфиг яйца, у которого стоит игрок
local opening = false
local queue = {}

local PREVIEW_DISTANCE = 13

local function tween(obj: Instance, time: number, props, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function setText(root: Instance, name: string, text: string)
	local l = root:FindFirstChild(name, true)
	if l and (l:IsA("TextLabel") or l:IsA("TextButton")) then
		l.Text = text
	end
end

local function rarityColor(rarity: string?): Color3
	return (rarity and PetConfig.Rarities[rarity]) or Color3.fromRGB(170, 175, 190)
end

local function priceText(egg): string
	if egg.RobuxProduct then
		return ("💎 %d Robux"):format(egg.RobuxPrice or 0)
	end
	return ("🏆 %s Побед"):format(Format.Comma(egg.Price))
end

-- ===== Окно у яйца =====
local function fillPreview(egg)
	local frame = gui:FindFirstChild("EggPreview") :: Frame
	local box = frame:FindFirstChild("EggBox") :: Frame
	box.BackgroundColor3 = egg.Color
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = egg.Color
	end
	setText(box, "Title", (egg.Name:gsub(" ", "\n", 1)))
	setText(box, "Price", priceText(egg))
	local list = frame:FindFirstChild("Pets") :: Frame
	local template = list:FindFirstChild("PetTemplate") :: Frame
	for _, child in ipairs(list:GetChildren()) do
		if child.Name == "Pet" then
			child:Destroy()
		end
	end
	for i, entry in ipairs(egg.Pets) do
		local def = Catalog.Pets[entry[1]]
		if def then
			local card = template:Clone()
			card.Name = "Pet"
			card.Visible = true
			card.LayoutOrder = i
			setText(card, "Emoji", def.Emoji or "🐾")
			setText(card, "PetName", def.Name)
			setText(card, "Mult", ("x%s Силы"):format(Format.Short(def.Multiplier)))
			setText(card, "Chance", tostring(entry[2]) .. "%")
			local s = card:FindFirstChildOfClass("UIStroke")
			if s then
				s.Color = rarityColor(def.Rarity)
			end
			card.Parent = list
		end
	end
	setText(frame, "OpenButton", egg.RobuxProduct and ("Открыть за " .. tostring(egg.RobuxPrice) .. " R$") or "Открыть")
end

local function nearestEgg()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local map = Workspace:FindFirstChild("Map")
	local hub = map and map:FindFirstChild("Hub")
	local folder = hub and hub:FindFirstChild("Eggs")
	if not root or not folder then
		return nil
	end
	local best, bestDist = nil, PREVIEW_DISTANCE
	for _, model in ipairs(folder:GetChildren()) do
		local id = model.Name:match("^Egg_(.+)$")
		local egg = id and Catalog.Eggs[id]
		if egg and model:IsA("Model") then
			local p = model:GetPivot().Position
			local d = (Vector3.new(p.X, root.Position.Y, p.Z) - root.Position).Magnitude
			if d < bestDist then
				best, bestDist = egg, d
			end
		end
	end
	return best
end

-- ===== Анимация открытия (лента как у кейсов) =====
local CARD_W, CARD_GAP = 150, 10
local WIN_INDEX = 34

local function weightedPick(egg)
	local total = 0
	for _, e in ipairs(egg.Pets) do
		total += e[2]
	end
	local r = math.random() * total
	for _, e in ipairs(egg.Pets) do
		r -= e[2]
		if r <= 0 then
			return e[1]
		end
	end
	return egg.Pets[1][1]
end

local function makeCard(template: Frame, petId: string, index: number): Frame
	local def = Catalog.Pets[petId]
	local card = template:Clone()
	card.Name = "Card"
	card.Visible = true
	card.Position = UDim2.new(0, (index - 1) * (CARD_W + CARD_GAP), 0.5, 0)
	local col = rarityColor(def and def.Rarity)
	card.BackgroundColor3 = col:Lerp(Color3.fromRGB(25, 15, 45), 0.55)
	local spot = card:FindFirstChild("Spot")
	if spot and spot:IsA("Frame") then
		spot.BackgroundColor3 = col
	end
	local s = card:FindFirstChildOfClass("UIStroke")
	if s then
		s.Color = col
	end
	setText(card, "Emoji", def and def.Emoji or "🐾")
	setText(card, "PetName", def and def.Name or petId)
	setText(card, "Mult", def and ("x" .. Format.Short(def.Multiplier)) or "")
	return card
end

local function playOpen(eggId: string, petId: string)
	local egg = Catalog.Eggs[eggId]
	local def = Catalog.Pets[petId]
	local frame = gui:FindFirstChild("EggOpen") :: Frame
	local reel = frame:FindFirstChild("Reel") :: Frame
	local strip = reel:FindFirstChild("Strip") :: Frame
	local template = reel:FindFirstChild("CardTemplate") :: Frame
	local win = frame:FindFirstChild("WinCard") :: Frame
	if not egg or not frame then
		return
	end

	for _, c in ipairs(strip:GetChildren()) do
		c:Destroy()
	end
	for i = 1, WIN_INDEX + 5 do
		local id = i == WIN_INDEX and petId or weightedPick(egg)
		makeCard(template, id, i).Parent = strip
	end
	setText(frame, "Title", "Открываем: " .. egg.Name)
	frame.Visible = true
	reel.Visible = true
	win.Visible = false
	frame.BackgroundTransparency = 1
	tween(frame, 0.25, { BackgroundTransparency = 0.25 })

	-- карточка WIN_INDEX должна оказаться точно под маркером в центре
	local reelWidth = reel.AbsoluteSize.X > 0 and reel.AbsoluteSize.X or 760
	local jitter = (math.random() - 0.5) * (CARD_W * 0.6)
	local target = -((WIN_INDEX - 1) * (CARD_W + CARD_GAP) + CARD_W / 2 - reelWidth / 2 + jitter)
	strip.Position = UDim2.new(0, 0, 0, 0)
	local spin = tween(strip, 4.6, { Position = UDim2.new(0, target, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	spin.Completed:Wait()
	task.wait(0.25)

	-- выигрыш: карточка выезжает и увеличивается
	local col = rarityColor(def and def.Rarity)
	win.BackgroundColor3 = col
	setText(win, "Emoji", def and def.Emoji or "🐾")
	setText(win, "PetName", def and def.Name or petId)
	setText(win, "Rarity", def and def.Rarity or "")
	setText(win, "Mult", def and ("x%s Силы"):format(Format.Short(def.Multiplier)) or "")
	local scale = win:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 0.4
	win.Visible = true
	tween(reel, 0.25, { BackgroundTransparency = 1 })
	reel.Visible = false
	tween(scale, 0.45, { Scale = 1.1 }, Enum.EasingStyle.Back).Completed:Wait()
	tween(scale, 0.2, { Scale = 1 })
	task.wait(1.6)
	tween(scale, 0.25, { Scale = 0 }).Completed:Wait()
	tween(frame, 0.2, { BackgroundTransparency = 1 }).Completed:Wait()
	frame.Visible = false
	reel.BackgroundTransparency = 0
	if def then
		Toasts.Show(("Выпал питомец: %s (x%s Силы)"):format(def.Name, Format.Short(def.Multiplier)), "pet")
	end
end

local function runQueue()
	if opening then
		return
	end
	opening = true
	while #queue > 0 do
		local item = table.remove(queue, 1)
		local ok, err = pcall(playOpen, item[1], item[2])
		if not ok then
			warn("[EggOpen]", err)
			local frame = gui:FindFirstChild("EggOpen")
			if frame and frame:IsA("GuiObject") then
				frame.Visible = false
			end
		end
	end
	opening = false
end

function Popups.Init()
	gui = player:WaitForChild("PlayerGui"):WaitForChild("MainHud") :: ScreenGui
	local preview = gui:WaitForChild("EggPreview") :: Frame
	local eggOpen = gui:WaitForChild("EggOpen") :: Frame
	preview.Visible = false
	eggOpen.Visible = false

	local openButton = preview:FindFirstChild("OpenButton", true)
	if openButton and openButton:IsA("GuiButton") then
		openButton.Activated:Connect(function()
			if not currentEgg or opening then
				return
			end
			local res = State.Request("OpenEgg", currentEgg.Id)
			if res and res.msg then
				Toasts.Show(res.msg, res.ok and "info" or "error")
			end
		end)
	end

	-- Показываем окно, когда игрок рядом с яйцом
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		local egg = nearestEgg()
		if egg ~= currentEgg then
			currentEgg = egg
			if egg then
				fillPreview(egg)
				preview.Visible = true
				local scale = preview:FindFirstChildOfClass("UIScale")
				if scale then
					scale.Scale = 0.8
					tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			else
				preview.Visible = false
			end
		end
		preview.Visible = currentEgg ~= nil and not opening
	end)

	Remotes.Event("Effect").OnClientEvent:Connect(function(kind, a, b)
		if kind == "Egg" then
			table.insert(queue, { a, b })
			task.spawn(runQueue)
		end
	end)
end

return Popups
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002337"><Properties>
<string name="Name">State</string>
<ProtectedString name="Source"><![CDATA[-- State — последние данные игрока с сервера + отправка запросов
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local State = {
	Snapshot = nil, -- { Data = ..., Passes = ..., RebirthCost = ..., ... }
	Data = nil,
	ReceivedAt = 0,
}
local changed = Instance.new("BindableEvent")
State.Changed = changed.Event

function State.Init()
	Remotes.Event("DataUpdate").OnClientEvent:Connect(function(snapshot)
		State.Snapshot = snapshot
		State.Data = snapshot.Data
		State.ReceivedAt = os.clock()
		changed:Fire(snapshot)
	end)
end

function State.HasPass(key: string): boolean
	return State.Snapshot ~= nil and State.Snapshot.Passes ~= nil and State.Snapshot.Passes[key] == true
end

-- Сколько секунд осталось до момента, который сервер прислал как "...ReadyIn"
function State.Countdown(field: string): number
	if not State.Snapshot or not State.Snapshot[field] then
		return 0
	end
	return math.max(0, State.Snapshot[field] - (os.clock() - State.ReceivedAt))
end

-- Отправить действие на сервер. Возвращает таблицу { ok = bool, msg = string? }
function State.Request(action: string, ...): any
	local args = table.pack(...)
	local ok, result = pcall(function()
		return Remotes.Function("Request"):InvokeServer(action, table.unpack(args, 1, args.n))
	end)
	if not ok then
		return { ok = false, msg = "Нет связи с сервером" }
	end
	return result or { ok = false }
end

return State
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002338"><Properties>
<string name="Name">Swing</string>
<ProtectedString name="Source"><![CDATA[--[[
	Swing — удар киркой: клик / тап, пока кирка в руках. Автоклик для владельцев геймпасса.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("GameSettings"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Controllers = script.Parent
local State = require(Controllers:WaitForChild("State"))

local Swing = {}
local player = Players.LocalPlayer
local lastSwing = 0
local currentTool: Tool? = nil

local function swing()
	local now = os.clock()
	if now - lastSwing < Settings.SwingCooldown then
		return
	end
	lastSwing = now
	Remotes.Event("Swing"):FireServer()
end

local function watchCharacter(character: Model)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == "Pickaxe" then
			currentTool = child
			child.Activated:Connect(swing)
		end
	end)
	character.ChildRemoved:Connect(function(child)
		if child == currentTool then
			currentTool = nil
		end
	end)
	local existing = character:FindFirstChild("Pickaxe")
	if existing and existing:IsA("Tool") then
		currentTool = existing
		existing.Activated:Connect(swing)
	end
end

function Swing.Init()
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then
		watchCharacter(player.Character)
	end
	-- Автоклик
	task.spawn(function()
		while true do
			task.wait(Settings.AutoClickInterval)
			local data = State.Data
			if currentTool and currentTool.Parent == player.Character and data and data.Settings.AutoClick and State.HasPass("AutoClick") then
				swing()
			end
		end
	end)
end

return Swing
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002339"><Properties>
<string name="Name">Toasts</string>
<ProtectedString name="Source"><![CDATA[-- Toasts — всплывающие сообщения и цифры «+сила»
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Toasts = {}
local container: Frame
local active = {}

local COLORS = {
	info = Color3.fromRGB(255, 255, 255),
	success = Color3.fromRGB(120, 255, 160),
	error = Color3.fromRGB(255, 120, 120),
	wins = Color3.fromRGB(255, 225, 77),
	pet = Color3.fromRGB(255, 160, 240),
	event = Color3.fromRGB(120, 220, 255),
}

local function makeLabel(text: string, color: Color3, size: number): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(0, 700, 0, size)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(26, 16, 51)
	stroke.Parent = label
	return label
end

function Toasts.Show(text: string, kind: string?)
	kind = kind or "info"
	local color = COLORS[kind] or COLORS.info
	if kind and kind:sub(1, 4) == "ore:" then
		color = Color3.fromRGB(255, 200, 120)
	end
	local label = makeLabel(text, color, 40)
	label.Position = UDim2.new(0.5, 0, 0.3, 0)
	label.Parent = container
	table.insert(active, 1, label)
	for i, l in ipairs(active) do
		if l.Parent then
			TweenService:Create(l, TweenInfo.new(0.2), { Position = UDim2.new(0.5, 0, 0.3, (i - 1) * 46) }):Play()
		end
	end
	label.Size = UDim2.new(0, 500, 0, 30)
	TweenService:Create(label, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Size = UDim2.new(0, 700, 0, 40) }):Play()
	task.delay(2.6, function()
		local t = TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 })
		t:Play()
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.4), { Transparency = 1 }):Play()
		end
		t.Completed:Wait()
		local i = table.find(active, label)
		if i then
			table.remove(active, i)
		end
		label:Destroy()
	end)
end

-- Летящая вверх цифра (например «+12 силы»)
function Toasts.Popup(text: string, color: Color3?)
	local label = makeLabel(text, color or Color3.fromRGB(255, 225, 77), 30)
	label.Size = UDim2.new(0, 260, 0, 30)
	local x = 0.5 + (math.random() - 0.5) * 0.12
	label.Position = UDim2.new(x, 0, 0.62, 0)
	label.Parent = container
	TweenService:Create(label, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { Position = UDim2.new(x, 0, 0.5, 0), TextTransparency = 1 }):Play()
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		TweenService:Create(stroke, TweenInfo.new(0.9), { Transparency = 1 }):Play()
	end
	game:GetService("Debris"):AddItem(label, 1)
end

function Toasts.Init()
	local gui = Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("MainHud")
	container = gui:WaitForChild("Toasts")
	Remotes.Event("Notify").OnClientEvent:Connect(Toasts.Show)
end

return Toasts
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX002340"><Properties>
<string name="Name">World</string>
<ProtectedString name="Source"><![CDATA[--[[
	World — то, что каждый игрок видит по-своему:
	• сломанные им слои стен исчезают только у него;
	• открытые им ямы теряют барьер;
	• прогресс на табличках уровней;
	• эффекты: обломки стены, «+сила».
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Config = ReplicatedStorage:WaitForChild("Config")
local PitConfig = require(Config:WaitForChild("PitConfig"))
local LevelConfig = require(Config:WaitForChild("LevelConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Controllers = script.Parent
local State = require(Controllers:WaitForChild("State"))
local Toasts = require(Controllers:WaitForChild("Toasts"))

local World = {}
local levels = {} -- [id] = { Layers = {part}, Sign = part }
local pits = {} -- [index] = { Barrier = part }
local original: { [BasePart]: number } = {}

local function numberFromName(name: string): number?
	return tonumber(name:match("(%d+)$"))
end

local function scan()
	local map = Workspace:WaitForChild("Map")
	local levelFolder = map:WaitForChild("Levels")
	for _, folder in ipairs(levelFolder:GetChildren()) do
		local id = numberFromName(folder.Name)
		local wall = folder:FindFirstChild("Wall")
		if id and wall then
			local layers = {}
			for _, layer in ipairs(wall:GetChildren()) do
				local n = numberFromName(layer.Name)
				if n and layer:IsA("BasePart") then
					layers[n] = layer
					original[layer] = layer.Transparency
				end
			end
			levels[id] = { Layers = layers, Sign = folder:FindFirstChild("Sign") }
		end
	end
	local pitFolder = map:WaitForChild("Hub"):FindFirstChild("Pits")
	if pitFolder then
		for _, model in ipairs(pitFolder:GetChildren()) do
			local n = numberFromName(model.Name)
			local barrier = model:FindFirstChild("LockBarrier")
			if n and barrier and barrier:IsA("BasePart") then
				pits[n] = { Barrier = barrier }
				original[barrier] = barrier.Transparency
			end
		end
	end
end

local function setVisible(part: BasePart, visible: boolean)
	part.Transparency = visible and (original[part] or 0) or 1
	part.CanCollide = visible
	part.CanQuery = visible
	for _, d in ipairs(part:GetDescendants()) do
		if d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
			d.Enabled = visible
		elseif d:IsA("Decal") or d:IsA("Texture") then
			d.Transparency = visible and 0 or 1
		end
	end
end

local function refresh()
	local data = State.Data
	if not data then
		return
	end
	for id, level in pairs(levels) do
		local prog = data.LevelProgress[tostring(id)] or 0
		for n, layer in pairs(level.Layers) do
			setVisible(layer, n > prog)
		end
		if level.Sign then
			local label = level.Sign:FindFirstChild("Progress", true)
			if label and label:IsA("TextLabel") then
				label.Text = ("Прогресс: %d / %d"):format(prog, LevelConfig.LayersPerLevel)
			end
		end
	end
	for index, pit in pairs(pits) do
		local cfg = PitConfig.Pits[index]
		local open = cfg ~= nil and data.Rebirths >= cfg.RequiredRebirths
		setVisible(pit.Barrier, not open)
	end
end

local function breakEffect(levelId: number, layerIndex: number)
	local level = levels[levelId]
	local layer = level and level.Layers[layerIndex]
	if not layer then
		return
	end
	for _ = 1, 14 do
		local chunk = Instance.new("Part")
		local s = 0.6 + math.random() * 1.2
		chunk.Size = Vector3.new(s, s, s)
		chunk.Color = layer.Color
		chunk.Material = layer.Material
		chunk.CanCollide = false
		chunk.CanQuery = false
		chunk.CanTouch = false
		local offset = Vector3.new((math.random() - 0.5) * layer.Size.X * 0.8, (math.random() - 0.3) * layer.Size.Y * 0.6, 0)
		chunk.CFrame = layer.CFrame * CFrame.new(offset)
		chunk.AssemblyLinearVelocity = layer.CFrame.LookVector * -(8 + math.random() * 12) + Vector3.new((math.random() - 0.5) * 16, 10 + math.random() * 12, 0)
		chunk.AssemblyAngularVelocity = Vector3.new(math.random() * 8, math.random() * 8, math.random() * 8)
		chunk.Parent = Workspace
		Debris:AddItem(chunk, 1.6)
	end
end

function World.Init()
	-- пиксельные текстуры карты (если ID указаны в TextureConfig)
	local ok, err = pcall(function()
		require(Shared:WaitForChild("TextureApplier")).Apply()
	end)
	if not ok then
		warn("[Textures]", err)
	end
	scan()
	State.Changed:Connect(refresh)
	Remotes.Event("Effect").OnClientEvent:Connect(function(kind, a, b)
		if kind == "Strength" then
			Toasts.Popup("+" .. Format.Short(a) .. " силы")
		elseif kind == "Break" then
			breakEffect(a, b)
		elseif kind == "LevelUp" then
			Toasts.Show("Новый уровень: " .. tostring(a) .. "!", "success")
		elseif kind == "Reward" then
			Toasts.Popup("+" .. Format.Short(b) .. " 🏆", Color3.fromRGB(255, 225, 77))
		end
	end)
end

return World
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
<Item class="StarterCharacterScripts" referent="RBX002341"><Properties>
<string name="Name">StarterCharacterScripts</string>
</Properties>
</Item>
</Item>
<Item class="StarterGui" referent="RBX002342"><Properties>
<string name="Name">StarterGui</string>
</Properties>
<Item class="ScreenGui" referent="RBX002343"><Properties>
<string name="Name">MainHud</string>
<bool name="ResetOnSpawn">false</bool>
<token name="ZIndexBehavior">1</token>
<bool name="IgnoreGuiInset">false</bool>
</Properties>
<Item class="UIScale" referent="RBX002344"><Properties>
<string name="Name">Scale</string>
<float name="Scale">1</float>
</Properties>
</Item>
<Item class="Frame" referent="RBX002345"><Properties>
<string name="Name">LeftMenu</string>
<Vector2 name="AnchorPoint"><X>0</X><Y>0</Y></Vector2>
<Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3>
<float name="BackgroundTransparency">1</float>
