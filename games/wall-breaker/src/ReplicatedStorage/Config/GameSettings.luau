--[[
	GameSettings — общие настройки игры.
	Меняйте числа прямо здесь, в Roblox Studio (двойной клик по модулю в Explorer).
]]

return {
	-- Сохранение
	DataStoreName = "WallBreaker_Data_v1", -- если поменять имя, у всех игроков начнётся новый прогресс
	AutoSaveInterval = 60, -- секунды между автосохранениями

	-- Удары киркой
	SwingCooldown = 0.3, -- минимальная пауза между ударами (секунды)
	WallReach = 12, -- с какого расстояния (в стадах) можно ударить стену
	AutoClickInterval = 0.35, -- скорость автоклика (геймпасс)
	AirSwingPower = 1, -- сила за удар по воздуху, до множителей (в ямах — Power из PitConfig, минимум ×2)
	StrengthMultiplier = 10, -- общий ускоритель силы: вся сила за удар × это число
	PitAutoInterval = 0.25, -- в открытой яме кирка бьёт сама раз в столько секунд (клики добавляют ещё)
	AutoBreakInterval = 0.6, -- в уровне стена бьётся сама раз в столько секунд (тапать — быстрее)

	-- Уровень игрока: опыт качается в ямах вместе с силой
	Xp = {
		PerPitPower = 3, -- опыт за удар в яме = Power ямы × это число
		Base = 10, -- опыт для перехода на уровень 2
		Growth = 1.3, -- каждый следующий уровень требует больше: Base × уровень^Growth
	},

	-- ТЕСТ: бесконечные победы и сила (прогресс таких игроков НЕ сохраняется,
	-- чтобы настоящее сохранение не испортилось). Перед релизом выключите.
	Infinite = {
		InStudio = true, -- у всех, кто тестирует в Studio
		ForOwner = true, -- у владельца игры и в опубликованной игре
		UserIds = {}, -- можно добавить номера аккаунтов, например { 123456 }
		Amount = 1e15,
	},

	-- «Мощный удар» (кнопка над полосой уровня): на время вся сила и урон умножаются
	PowerStrike = {
		Multiplier = 3,
		Duration = 15, -- секунд действует
		Cooldown = 60, -- секунд перезарядка (считается с момента включения)
	},

	-- Питомцы
	MaxEquippedPets = 3, -- сколько питомцев можно надеть одновременно
	MaxPetsInInventory = 60, -- размер инвентаря питомцев

	-- Редкий торговец на уровнях
	RareMerchant = {
		CheckInterval = 90, -- раз в сколько секунд пробуем его вызвать
		Chance = 0.35, -- шанс появления при каждой проверке (0.35 = 35%)
		Duration = 120, -- сколько секунд он стоит
		PriceMultiplier = 2, -- во сколько раз дороже покупает руды, чем обычный торговец
	},

	-- Стартовые значения нового игрока
	StartWins = 0,
	StartStrength = 0,
	StartPickaxe = "wood", -- Id кирки из PickaxeConfig

	-- Отладка: в Studio каждый новый игрок получает это количество побед (0 = выключено)
	StudioTestWins = 0,
}
